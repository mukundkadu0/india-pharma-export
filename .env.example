# Copy to .env for local dev, and set the same keys in Vercel > Project > Environment
# Variables for production. Never commit real values. Nothing here is exposed to the
# browser — these are read only inside src/pages/api/*.

# Airtable — where bulk leads are stored. Until these are set, /api/bulk-lead
# returns 503 and the form falls back to the existing Web3Forms delivery.
AIRTABLE_TOKEN=
AIRTABLE_BASE=
AIRTABLE_TABLE=

# Transactional email (Resend). FROM_EMAIL must be on a domain you control and
# have verified — the current @indiapharmaexport.com addresses do not resolve.
RESEND_API_KEY=
SALES_EMAIL=
FROM_EMAIL=
REPLY_TO_EMAIL=

# Cloudflare Turnstile — optional. When unset, the endpoint skips captcha
# verification and relies on the honeypot plus rate limiting.
TURNSTILE_SECRET=

# ---- Google (public IDs; safe in the browser) --------------------------------------
# Leave both empty to load no Google tags and show no consent banner.
# Use GTM when possible (manage GA4 + Google Ads inside Tag Manager). GA4 is used
# directly only when no GTM ID is set. See docs/GOOGLE_SETUP_GUIDE.md.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=

# Optional: send the visitor an acknowledgement email. OFF by default because it mails an
# address typed by an anonymous visitor (abuse risk). Set to "true" only with Turnstile on.
SEND_ACK_EMAIL=

# Rate limit per IP per 10 minutes (default 8). The built-in limiter is in-memory, so also
# add a Vercel Firewall rate-limit rule (docs/HOSTING_CONFIGURATION.md).
RFQ_RATE_LIMIT=

# TEST ONLY: point the API at a mock server for staging tests. Leave empty in production.
AIRTABLE_API_BASE=
RESEND_API_BASE=
