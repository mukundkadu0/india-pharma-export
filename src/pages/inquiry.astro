---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

const incoterms = ['FOB', 'CIF', 'CFR', 'EXW', 'DAP', 'Not sure yet'];
---

<BaseLayout
  title="Your Inquiry List — India Pharma Export"
  description="Review the products you've added to your inquiry list and submit a single B2B procurement request across multiple products."
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Inquiry List' }]} />
  </div>

  <section class="container-page pt-6 pb-10">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Inquiry List</p>
    <h1 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] max-w-2xl">Submit a Multi-Product Inquiry</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">
      Add products from the catalogue with "Add to Inquiry List," then submit one procurement request covering everything below — designed for B2B sourcing, not a shopping checkout.
    </p>
  </section>

  <section class="container-page pb-20 grid lg:grid-cols-5 gap-10">
    <div class="lg:col-span-2">
      <h2 class="font-semibold text-[color:var(--color-navy)] mb-4">Your Products</h2>
      <div id="inquiry-items" class="space-y-3"></div>
      <p id="inquiry-empty" class="hidden text-sm text-slate-500 rounded-xl border border-dashed border-slate-300 p-6 text-center">
        Your inquiry list is empty. Browse the <a href="/products/" class="text-[color:var(--color-blue)] underline">product catalogue</a> and select "Add to Inquiry List" on any product.
      </p>
      <button id="clear-inquiry" type="button" class="hidden mt-3 text-xs text-slate-400 hover:text-[color:var(--color-error)]">Clear all</button>
    </div>

    <div class="lg:col-span-3">
      <form id="inquiry-form" data-endpoint={site.formEndpoint} data-fallback-email={site.email} class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8" novalidate>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="iq-company" class="block text-sm font-medium text-slate-700 mb-1.5">Company *</label>
            <input id="iq-company" name="company" type="text" required class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]" />
          </div>
          <div>
            <label for="iq-country" class="block text-sm font-medium text-slate-700 mb-1.5">Country *</label>
            <input id="iq-country" name="country" type="text" required class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]" />
          </div>
          <div>
            <label for="iq-contact" class="block text-sm font-medium text-slate-700 mb-1.5">Contact Name *</label>
            <input id="iq-contact" name="contact" type="text" required class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]" />
          </div>
          <div>
            <label for="iq-email" class="block text-sm font-medium text-slate-700 mb-1.5">Email *</label>
            <input id="iq-email" name="email" type="email" required class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]" />
          </div>
          <div>
            <label for="iq-phone" class="block text-sm font-medium text-slate-700 mb-1.5">Phone</label>
            <input id="iq-phone" name="phone" type="tel" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]" />
          </div>
          <div>
            <label for="iq-market" class="block text-sm font-medium text-slate-700 mb-1.5">Target Market</label>
            <input id="iq-market" name="targetMarket" type="text" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]" />
          </div>
          <div>
            <label for="iq-incoterm" class="block text-sm font-medium text-slate-700 mb-1.5">Incoterm</label>
            <select id="iq-incoterm" name="incoterm" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm bg-white outline-none focus:border-[color:var(--color-blue)]">
              {incoterms.map((i) => <option value={i}>{i}</option>)}
            </select>
          </div>
          <div>
            <label for="iq-packaging" class="block text-sm font-medium text-slate-700 mb-1.5">Packaging</label>
            <input id="iq-packaging" name="packaging" type="text" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]" />
          </div>
          <div class="sm:col-span-2">
            <label for="iq-message" class="block text-sm font-medium text-slate-700 mb-1.5">Message</label>
            <textarea id="iq-message" name="message" rows="4" class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]"></textarea>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="iq-hp">Leave blank</label>
            <input id="iq-hp" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="access_key" value={site.formAccessKey} />
          <input type="hidden" name="subject" value="New B2B Inquiry — India Pharma Export" />
        </div>
        <p id="iq-status" class="mt-4 text-sm hidden" role="status"></p>
        <div class="mt-6">
          <Button type="submit" size="lg">Submit Inquiry</Button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const STORAGE_KEY = 'ipe-inquiry-list';
  type InquiryItem = { id: string; name: string; meta?: string };

  function readList(): InquiryItem[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }
  function writeList(list: InquiryItem[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    } catch {}
    render();
    window.dispatchEvent(new Event('storage'));
  }

  const itemsEl = document.getElementById('inquiry-items');
  const emptyEl = document.getElementById('inquiry-empty');
  const clearBtn = document.getElementById('clear-inquiry');

  function render() {
    const list = readList();
    if (!itemsEl || !emptyEl || !clearBtn) return;
    if (list.length === 0) {
      itemsEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      clearBtn.classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    clearBtn.classList.remove('hidden');
    itemsEl.innerHTML = list
      .map(
        (item, i) => `
      <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 p-4">
        <div class="min-w-0">
          <p class="text-sm font-medium text-[color:var(--color-ink)] truncate">${item.name}</p>
          <label class="text-xs text-slate-400" for="qty-${i}">Estimated quantity</label>
          <input id="qty-${i}" data-idx="${i}" class="qty-input mt-1 block w-40 rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs" placeholder="e.g. 50,000 units" />
        </div>
        <button type="button" data-remove="${item.id}" aria-label="Remove ${item.name}" class="shrink-0 text-slate-400 hover:text-[color:var(--color-error)]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="w-5 h-5"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
        </button>
      </div>`
      )
      .join('');

    itemsEl.querySelectorAll('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.remove;
        writeList(readList().filter((item) => item.id !== id));
      });
    });
  }

  clearBtn?.addEventListener('click', () => writeList([]));
  render();

  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('iq-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const honeypot = (form.elements.namedItem('companyWebsite') as HTMLInputElement)?.value;
    if (honeypot) return;

    const list = readList();
    if (list.length === 0) {
      if (status) {
        status.textContent = 'Add at least one product to your inquiry list before submitting.';
        status.className = 'mt-4 text-sm text-[color:var(--color-error)]';
      }
      return;
    }

    const qtyInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.qty-input'));
    const productLines = list.map((item, i) => `${item.name}${qtyInputs[i]?.value ? ` — ${qtyInputs[i].value}` : ''}`);

    const data = new FormData(form);
    const endpoint = form.dataset.endpoint;
    const fallbackEmail = form.dataset.fallbackEmail;

    if (endpoint) {
      data.append('products', productLines.join('; '));
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('failed');
        if (status) {
          status.textContent = 'Thank you — your inquiry has been received. Our team will respond within 1–2 business days.';
          status.className = 'mt-4 text-sm text-[color:var(--color-success)]';
        }
        writeList([]);
        form.reset();
      } catch {
        if (status) {
          status.textContent = `Something went wrong sending this automatically. Please email us directly at ${fallbackEmail}.`;
          status.className = 'mt-4 text-sm text-[color:var(--color-error)]';
        }
      }
      return;
    }

    const lines = [
      `Company: ${data.get('company') ?? ''}`,
      `Country: ${data.get('country') ?? ''}`,
      `Contact: ${data.get('contact') ?? ''}`,
      `Email: ${data.get('email') ?? ''}`,
      `Phone: ${data.get('phone') ?? ''}`,
      `Target Market: ${data.get('targetMarket') ?? ''}`,
      `Incoterm: ${data.get('incoterm') ?? ''}`,
      `Packaging: ${data.get('packaging') ?? ''}`,
      `Message: ${data.get('message') ?? ''}`,
      '',
      'Products:',
      ...productLines.map((l) => `- ${l}`),
    ];
    const subject = encodeURIComponent(`B2B Inquiry — ${data.get('company') ?? 'New Inquiry'}`);
    const body = encodeURIComponent(lines.join('\n'));
    window.location.href = `mailto:${fallbackEmail}?subject=${subject}&body=${body}`;
    if (status) {
      status.textContent = 'Opening your email client with this inquiry pre-filled — please send it to complete your request.';
      status.className = 'mt-4 text-sm text-slate-600';
    }
  });
</script>
