---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { buyerTypes } from '../data/taxonomy';

const incoterms = ['FOB', 'CIF', 'CFR', 'EXW', 'DAP', 'Not sure yet'];
---

<BaseLayout
  title="Your RFQ List: PharmaXports"
  description="Review the products you've added to your inquiry list and submit a single B2B procurement request across multiple products."
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'RFQ List' }]} />
  </div>

  <section class="container-page pt-6 pb-10">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent-dark)] mb-3">RFQ list</p>
    <h1 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] max-w-2xl">Submit a multi-product RFQ</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">
      Add products from the catalogue with "Add to RFQ list," then submit one procurement request covering everything below — designed for B2B sourcing, not a shopping checkout.
    </p>
  </section>

  <section class="container-page pb-20 grid lg:grid-cols-5 gap-10">
    <div class="lg:col-span-2">
      <h2 class="font-semibold text-[color:var(--color-navy)] mb-4">Your Products</h2>
      <div id="inquiry-items" class="space-y-3"></div>
      <p id="inquiry-empty" class="hidden text-sm text-slate-500 rounded-xl border border-dashed border-slate-300 p-6 text-center">
        Your RFQ list is empty. Browse the <a href="/products/" class="text-[color:var(--color-blue)] underline">product catalogue</a> and select "Add to RFQ list" on any product.
      </p>
      <button id="clear-inquiry" type="button" class="hidden mt-3 text-xs text-slate-500 hover:text-[color:var(--color-error)]">Clear all</button>
    </div>

    <div class="lg:col-span-3">
      <form id="inquiry-form" data-endpoint={site.formEndpoint} data-fallback-email={site.email} class="card p-5 sm:p-8" novalidate>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="iq-company" class="label">Company *</label>
            <input id="iq-company" name="company" type="text" required class="field" />
          </div>
          <div>
            <label for="iq-country" class="label">Country *</label>
            <input id="iq-country" name="country" type="text" required class="field" />
          </div>
          <div>
            <label for="iq-contact" class="label">Contact Name *</label>
            <input id="iq-contact" name="contact" type="text" required class="field" />
          </div>
          <div>
            <label for="iq-buyer" class="label">Buyer type *</label>
            <select id="iq-buyer" name="buyerType" required class="field">
              <option value="">Select buyer type…</option>
              {buyerTypes.map((b) => <option value={b.name}>{b.name}</option>)}
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label for="iq-email" class="label">Email *</label>
            <input id="iq-email" name="email" type="email" required class="field" />
          </div>
          <div>
            <label for="iq-phone" class="label">Phone</label>
            <input id="iq-phone" name="phone" type="tel" class="field" />
          </div>
          <div>
            <label for="iq-market" class="label">Target Market</label>
            <input id="iq-market" name="targetMarket" type="text" class="field" />
          </div>
          <div>
            <label for="iq-incoterm" class="label">Incoterm</label>
            <select id="iq-incoterm" name="incoterm" class="field">
              {incoterms.map((i) => <option value={i}>{i}</option>)}
            </select>
          </div>
          <div>
            <label for="iq-packaging" class="label">Packaging</label>
            <input id="iq-packaging" name="packaging" type="text" class="field" />
          </div>
          <div class="sm:col-span-2">
            <label for="iq-message" class="label">Message</label>
            <textarea id="iq-message" name="message" rows="4" class="field"></textarea>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="iq-hp">Leave blank</label>
            <input id="iq-hp" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="access_key" value={site.formAccessKey} />
          <input type="hidden" name="subject" value="New B2B Inquiry — PharmaXports" />
        </div>
        <p id="iq-status" class="mt-4 text-sm hidden" role="status"></p>
        <div class="mt-6">
          <button type="submit" class="btn btn-primary btn-lg">Submit RFQ</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { submitEnquiry, trackRfqSubmit } from '../lib/rfq-client';
  const STORAGE_KEY = 'ipe-inquiry-list';
  type InquiryItem = { id: string; name: string; meta?: string };

  function readList(): InquiryItem[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }
  function writeList(list: InquiryItem[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    } catch {}
    render();
    window.dispatchEvent(new Event('storage'));
  }

  const itemsEl = document.getElementById('inquiry-items');
  const emptyEl = document.getElementById('inquiry-empty');
  const clearBtn = document.getElementById('clear-inquiry');

  function render() {
    const list = readList();
    if (!itemsEl || !emptyEl || !clearBtn) return;
    if (list.length === 0) {
      itemsEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      clearBtn.classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    clearBtn.classList.remove('hidden');
    itemsEl.innerHTML = list
      .map(
        (item, i) => `
      <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 p-4">
        <div class="min-w-0">
          <p class="text-sm font-medium text-[color:var(--color-ink)] truncate">${item.name}</p>
          <label class="text-xs text-slate-500" for="qty-${i}">Estimated quantity</label>
          <input id="qty-${i}" data-idx="${i}" class="qty-input mt-1 block w-40 rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs" placeholder="e.g. 50,000 units" />
        </div>
        <button type="button" data-remove="${item.id}" aria-label="Remove ${item.name}" class="shrink-0 text-slate-500 hover:text-[color:var(--color-error)]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="w-5 h-5"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
        </button>
      </div>`
      )
      .join('');

    itemsEl.querySelectorAll('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.remove;
        writeList(readList().filter((item) => item.id !== id));
      });
    });
  }

  clearBtn?.addEventListener('click', () => writeList([]));
  render();

  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('iq-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const honeypot = (form.elements.namedItem('companyWebsite') as HTMLInputElement)?.value;
    if (honeypot) return;

    const list = readList();
    if (list.length === 0) {
      if (status) {
        status.textContent = 'Add at least one product to your RFQ list before submitting.';
        status.className = 'mt-4 text-sm text-[color:var(--color-error)]';
      }
      return;
    }

    const qtyInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.qty-input'));
    const productLines = list.map((item, i) => `${item.name}${qtyInputs[i]?.value ? ` — ${qtyInputs[i].value}` : ''}`);

    const data = new FormData(form);
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    if (status) {
      status.textContent = 'Sending…';
      status.className = 'mt-4 text-sm text-slate-600';
    }

    const result = await submitEnquiry(form, 'buyer', form.dataset.endpoint || '', {
      fullName: String(data.get('contact') ?? ''),
      companyName: String(data.get('company') ?? ''),
      buyerType: String(data.get('buyerType') ?? ''),
      product: productLines.join('; '),
      quantity: 'As listed against each product',
      message: [`Incoterm: ${data.get('incoterm') ?? ''}`, `Products (${list.length}):`, ...productLines.map((x) => `- ${x}`), '', String(data.get('message') ?? '')].join('\n'),
    });

    if (result.ok) {
      trackRfqSubmit('buyer', result.reference, { item_name: `${list.length} products`, country: String(data.get('country') ?? ''), source: 'inquiry_list' });
      if (status) {
        status.textContent = `Thank you. Your inquiry has been received. Reference: ${result.reference}. Our team will respond within 1-2 business days.`;
        status.className = 'mt-4 text-sm text-[color:var(--color-success)]';
      }
      writeList([]);
      form.reset();
    } else if (status) {
      status.textContent = `${result.error} If it keeps failing, email us at ${form.dataset.fallbackEmail}.`;
      status.className = 'mt-4 text-sm text-[color:var(--color-error)]';
    }
    if (submitBtn) submitBtn.disabled = false;
  });
</script>