---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import StatCard from '../components/StatCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import MarketCard from '../components/MarketCard.astro';
import MarketNetworkMap from '../components/MarketNetworkMap.astro';
import TrustPillar from '../components/TrustPillar.astro';
import Accordion from '../components/Accordion.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTASection from '../components/CTASection.astro';
import { categoryGroups, buyerTypes } from '../data/taxonomy';

const allProducts = await getCollection('products');
const featured = allProducts.filter((p) => p.data.featured).slice(0, 8);
const featuredProducts = (featured.length >= 4 ? featured : allProducts.slice(0, 6)).map((p) => p.data);

const markets = await getCollection('markets');
const resources = await getCollection('resources');
const featuredResources = resources.filter((r) => r.data.featured).concat(resources).slice(0, 3);
const faqs = await getCollection('faqs');
const homeFaqIds = ['bulk-request', 'which-countries', 'how-to-quote', 'moq-question', 'consumer-orders', 'export-timeline'];
const homeFaqs = homeFaqIds
  .map((id) => faqs.find((f) => f.id === id))
  .filter(Boolean)
  .map((f) => ({ question: f!.data.question, answer: f!.data.answer }));

const searchExamples = ['Paracetamol', 'Amoxicillin', 'Omeprazole', 'Metformin', 'Azithromycin', 'Dolutegravir', 'Artemether + Lumefantrine'];
---

<BaseLayout
  title="India Pharma Export — India's Trusted Partner in Pharmaceutical Exports"
  description="India Pharma Export is a B2B pharmaceutical sourcing and export platform connecting international buyers with WHO-GMP partner-manufactured formulations, APIs, biologicals, devices, AYUSH and nutraceutical products from India."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-b from-white to-[color:var(--color-blue-light)]">
    <div class="container-page py-14 sm:py-20 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-4">Global Access to Better Health</p>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.25rem] leading-[1.08] text-[color:var(--color-navy)]">
          India&rsquo;s Trusted Partner in Pharmaceutical Exports
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 max-w-xl leading-relaxed">
          High-quality formulations, APIs, healthcare products and specialised pharmaceutical solutions, sourced from WHO-GMP certified Indian manufacturing partners for international B2B buyers.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/request-quote/" size="lg">Export Enquiry</Button>
          <Button href="/products/" variant="outline" size="lg">Explore Product Catalogue</Button>
        </div>
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
          {[
            { icon: 'shield-check', label: 'Quality Assured' },
            { icon: 'globe', label: 'Global Reach' },
            { icon: 'user-group', label: 'Reliable Partnership' },
          ].map((t) => (
            <div class="flex items-center gap-2 text-sm font-medium text-[color:var(--color-navy)]">
              <Icon name={t.icon} class="w-4.5 h-4.5 text-[color:var(--color-accent)]" /> {t.label}
            </div>
          ))}
        </div>
      </div>

      <div class="relative">
        <div class="rounded-3xl bg-[color:var(--color-navy)] p-8 sm:p-10 text-white shadow-xl">
          <p class="text-xs font-semibold tracking-[0.15em] uppercase text-white/60">Built for B2B pharmaceutical trade</p>
          <p class="mt-4 font-display text-2xl leading-snug">Product discovery to export documentation, in one platform.</p>
          <ul class="mt-6 space-y-3 text-sm text-white/85">
            <li class="flex items-center gap-2"><Icon name="check-circle" class="w-4.5 h-4.5 text-[color:var(--color-accent)] shrink-0" /> WHO-GMP partner-manufactured supply</li>
            <li class="flex items-center gap-2"><Icon name="check-circle" class="w-4.5 h-4.5 text-[color:var(--color-accent)] shrink-0" /> Quote-based, not a consumer checkout</li>
            <li class="flex items-center gap-2"><Icon name="check-circle" class="w-4.5 h-4.5 text-[color:var(--color-accent)] shrink-0" /> Regulatory-aware, destination-verified guidance</li>
          </ul>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-xl bg-white/10 p-4">
              <p class="font-display text-2xl">36</p>
              <p class="text-xs text-white/70 mt-1">Therapeutic classes tracked</p>
            </div>
            <div class="rounded-xl bg-white/10 p-4">
              <p class="font-display text-2xl">8</p>
              <p class="text-xs text-white/70 mt-1">Export product categories</p>
            </div>
          </div>
        </div>
        <div class="hidden sm:block absolute -bottom-6 -left-6 rounded-2xl bg-white shadow-lg p-4 border border-slate-100">
          <p class="text-[10px] uppercase tracking-wide text-slate-400 font-semibold">Buyer model</p>
          <p class="text-sm font-semibold text-[color:var(--color-navy)] mt-0.5">Request Quote → not Buy Now</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRY STATS -->
  <section class="bg-white border-y border-slate-100">
    <div class="container-page py-10">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-slate-400 text-center mb-6">Indian Pharmaceutical Export Industry — FY 2024–25</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-slate-100 border border-slate-100 rounded-2xl overflow-hidden">
        <StatCard value="$30.4bn" label="Pharma exports, FY 2024–25" />
        <StatCard value="+9.4%" label="Year-on-year growth" />
        <StatCard value="75.7%" label="Share from formulations & biologicals" />
        <StatCard value="200+" label="Destination countries served by Indian exporters" />
      </div>
      <p class="text-center text-xs text-slate-400 mt-4 max-w-2xl mx-auto">
        Industry-wide figures for Indian pharmaceutical exports, not company-specific performance data. See our
        <a href="/resources/pharma-export-market-compliance-guide-2026/" class="underline hover:text-[color:var(--color-blue)]">market guide</a> for sourcing.
      </p>
    </div>
  </section>

  <!-- PRODUCT CATEGORIES -->
  <section class="container-page py-16 sm:py-20">
    <div class="max-w-2xl mx-auto text-center mb-10">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Product Catalogue</p>
      <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">Explore India&rsquo;s Export-Ready Product Categories</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {categoryGroups.map((c) => <CategoryCard {...c} />)}
    </div>
  </section>

  <!-- PRODUCT DISCOVERY -->
  <section class="bg-[color:var(--color-navy)]">
    <div class="container-page py-16 sm:py-20 text-center">
      <h2 class="font-display text-3xl sm:text-4xl text-white">Find the Pharmaceutical Product You Need</h2>
      <p class="mt-3 text-white/70 max-w-xl mx-auto">Search by molecule, formulation, API, product or HS code across our full catalogue.</p>
      <form id="home-search-form" action="/products/" method="get" class="mt-8 max-w-2xl mx-auto flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <Icon name="search" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" />
          <input
            type="text"
            name="q"
            placeholder="Search molecule, formulation, API, product or HS code…"
            class="w-full rounded-full pl-12 pr-4 py-3.5 text-sm text-[color:var(--color-ink)] outline-none focus:ring-2 focus:ring-[color:var(--color-accent)]"
          />
        </div>
        <Button type="submit" size="lg">Search Catalogue</Button>
      </form>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        {searchExamples.map((ex) => (
          <a href={`/products/?q=${encodeURIComponent(ex)}`} class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-white/80 hover:bg-white/20">{ex}</a>
        ))}
      </div>
      <p class="mt-6 text-xs text-white/40 max-w-lg mx-auto">
        Product discovery is for sourcing purposes only and does not constitute medical advice. See <a href="/glossary/" class="underline">Glossary</a> and <a href="/compliance/" class="underline">Compliance</a> for definitions and regulatory context.
      </p>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section class="container-page py-16 sm:py-20">
    <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Featured Products</p>
        <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">Ready for B2B Sourcing</h2>
      </div>
      <a href="/products/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--color-blue)] hover:underline">
        View All Products <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {featuredProducts.map((p) => <ProductCard {...p} />)}
    </div>
  </section>

  <!-- MARKETS + MAP -->
  <section class="bg-[color:var(--color-blue-light)]">
    <div class="container-page py-16 sm:py-20">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Global Markets</p>
        <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">Where We Help Buyers Source</h2>
        <p class="mt-3 text-slate-600">Requirements vary by product and destination. Explore a region to see typical categories, buyer types and regulatory pathway.</p>
      </div>
      <MarketNetworkMap />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-10">
        {markets.map((m) => <MarketCard {...m.data} />)}
      </div>
    </div>
  </section>

  <!-- WHY INDIA PHARMA EXPORT -->
  <section class="container-page py-16 sm:py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Why India Pharma Export</p>
        <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] leading-tight">Built for Global Buyers</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          We operate as a merchant exporter — sourcing from WHO-GMP certified Indian manufacturing partners rather than manufacturing in-house — and structure every enquiry around what a licensed international buyer actually needs: verified product information, honest regulatory context, and complete export documentation.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-7">
        <TrustPillar icon="building" title="Manufacturing Partner Network" description="Sourcing from WHO-GMP certified Indian manufacturing partners across formulations, APIs, biologicals and devices." />
        <TrustPillar icon="globe" title="Global Market Coverage" description="Corridor-aware guidance across Africa, South-East Asia, the Middle East, Latin America, CIS and beyond." />
        <TrustPillar icon="document" title="Export Documentation Support" description="COPP, Certificate of Analysis, GMP certificates and full shipment documentation coordinated per consignment." />
        <TrustPillar icon="shield-check" title="Regulatory Awareness" description="Export and prescription status checked per product and destination — never assumed from a general listing." />
        <TrustPillar icon="truck" title="Bulk Supply Capability" description="Institutional, tender and wholesale-volume supply coordinated with manufacturing partners." />
        <TrustPillar icon="user-group" title="Long-Term Partnerships" description="Built around repeat B2B relationships, not one-off transactions." />
      </div>
    </div>
  </section>

  <!-- COMPLIANCE TEASER -->
  <section class="bg-[color:var(--color-navy-deep)] text-white">
    <div class="container-page py-16 sm:py-20">
      <div class="max-w-2xl mb-10">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Compliance</p>
        <h2 class="font-display text-3xl sm:text-4xl">Compliance You Can Trust</h2>
        <p class="mt-3 text-white/70">Every export relationship runs through the same regulatory foundation, from company setup through to destination registration.</p>
      </div>
      <div class="grid sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {[
          '1. Exporter Setup',
          '2. Product & Manufacturer Qualification',
          '3. Regulatory Review',
          '4. Destination Registration',
          '5. Documentation',
          '6. Shipment',
        ].map((step) => (
          <div class="rounded-xl bg-white/5 border border-white/10 p-4 text-sm font-medium">{step}</div>
        ))}
      </div>
      <p class="mt-6 text-xs text-white/50 max-w-2xl">
        Regulatory requirements vary by product, destination and export status. Verify current requirements with the relevant Indian and destination-country authorities before shipment.
      </p>
      <div class="mt-6">
        <Button href="/compliance/" variant="outline" class="!border-white !text-white hover:!bg-white hover:!text-[color:var(--color-navy)]">View Full Compliance Framework</Button>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="container-page py-16 sm:py-20">
    <div class="max-w-2xl mx-auto text-center mb-10">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Buyer Flow</p>
      <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">How It Works</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { n: '01', t: 'Tell us what you need', d: 'Submit a product, molecule or bulk requirement through our quote form.' },
        { n: '02', t: 'We identify suitable supply options', d: 'Our team matches your requirement to WHO-GMP certified manufacturing partners.' },
        { n: '03', t: 'Regulatory and destination review', d: 'Export and prescription status confirmed for your specific product and market.' },
        { n: '04', t: 'Receive quotation', d: 'FOB/CIF pricing, MOQ, packaging and lead time confirmed in writing.' },
        { n: '05', t: 'Documentation and order processing', d: 'COPP, Certificate of Analysis, GMP certificate and shipment paperwork prepared.' },
        { n: '06', t: 'Shipment', d: 'Consignment shipped against agreed Incoterms with full documentation.' },
      ].map((step) => (
        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <p class="font-display text-2xl text-[color:var(--color-accent)]">{step.n}</p>
          <h3 class="mt-2 font-semibold text-[color:var(--color-navy)]">{step.t}</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{step.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- BUYER TYPES -->
  <section class="bg-white border-y border-slate-100">
    <div class="container-page py-16 sm:py-20">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Who We Serve</p>
        <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">Built for Every Type of B2B Buyer</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {buyerTypes.map((b) => (
          <div class="p-5 rounded-2xl border border-slate-200">
            <h3 class="font-semibold text-[color:var(--color-navy)]">{b.name}</h3>
            <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{b.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BULK REQUIREMENT FORM -->
  <section id="get-quote" class="container-page py-16 sm:py-20">
    <div class="grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-2">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Request a Quote</p>
        <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] leading-tight">Looking for Bulk Pharmaceutical Supply?</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Tell us the products, quantities and markets you're targeting. Our team reviews regulatory and supply considerations before responding with a formal quotation.
        </p>
        <div class="mt-6 flex items-center gap-3 text-sm text-slate-500">
          <Icon name="shield-check" class="w-5 h-5 text-[color:var(--color-success)]" /> Protected against spam with honeypot verification.
        </div>
      </div>
      <div class="lg:col-span-3">
        <QuoteForm />
      </div>
    </div>
  </section>

  <!-- RESOURCES -->
  <section class="bg-[color:var(--color-blue-light)]">
    <div class="container-page py-16 sm:py-20">
      <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Buyer Resources</p>
          <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">From Product Search to Export Documentation</h2>
        </div>
        <a href="/resources/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--color-blue)] hover:underline">
          Explore Resources <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredResources.map((r) => (
          <a href={`/resources/${r.id}/`} class="flex flex-col p-6 bg-white rounded-2xl border border-slate-200 hover:shadow-lg transition-shadow">
            <span class="text-xs font-semibold uppercase tracking-wide text-[color:var(--color-blue)]">{r.data.category}</span>
            <h3 class="mt-2 font-display text-lg text-[color:var(--color-navy)] leading-snug">{r.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{r.data.excerpt}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-blue)]">Read More <Icon name="arrow-right" class="w-3.5 h-3.5" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page py-16 sm:py-20 max-w-3xl mx-auto">
    <div class="text-center mb-8">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">FAQ</p>
      <h2 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">Common Questions</h2>
    </div>
    <Accordion items={homeFaqs} idPrefix="home-faq" />
    <div class="text-center mt-8">
      <Button href="/faqs/" variant="ghost">View All FAQs</Button>
    </div>
  </section>

  <CTASection
    eyebrow="Get Started"
    heading="Build Your Global Pharmaceutical Supply Chain With India"
    body="Tell us the products and markets you are targeting. Our team can help evaluate suitable supply and export requirements."
    primaryLabel="Get an Export Quote"
    primaryHref="/request-quote/"
    secondaryLabel="Read the Export Guide"
    secondaryHref="/resources/pharma-export-market-compliance-guide-2026/"
  />
</BaseLayout>
