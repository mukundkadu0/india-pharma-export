---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import MarketCard from '../components/MarketCard.astro';
import TrustPillar from '../components/TrustPillar.astro';
import Accordion from '../components/Accordion.astro';
import QuoteForm from '../components/QuoteForm.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import { categoryGroups, marketSkyline } from '../data/taxonomy';
import { buyerSegments } from '../data/buyers';

const allProducts = await getCollection('products');
const featured = allProducts.filter((p) => p.data.featured).slice(0, 8);
const featuredProducts = (featured.length >= 4 ? featured : allProducts.slice(0, 6)).map((p) => p.data).slice(0, 4);

const classes = (await getCollection('classes')).map((c) => c.data);
const categoryCounts = Object.fromEntries(categoryGroups.map((c) => [c.id, classes.filter((cl) => cl.categoryGroup === c.id).length]));
const topClasses = classes
  .filter((c) => c.exportStatus === 'free' && c.listedCount > 0)
  .sort((a, b) => b.listedCount - a.listedCount)
  .slice(0, 10);

const marketOrder = ['united-states', 'europe-uk', 'africa', 'latin-america', 'cis-russia', 'middle-east', 'southeast-asia'];
const markets = (await getCollection('markets')).sort((a, b) => marketOrder.indexOf(a.data.id) - marketOrder.indexOf(b.data.id));
const resources = await getCollection('resources');
const featuredResources = resources.filter((r) => r.data.featured).concat(resources).slice(0, 3);
const faqs = await getCollection('faqs');
const homeFaqIds = ['bulk-request', 'which-countries', 'how-to-quote', 'moq-question', 'consumer-orders', 'export-timeline'];
const homeFaqs = homeFaqIds
  .map((id) => faqs.find((f) => f.id === id))
  .filter(Boolean)
  .map((f) => ({ question: f!.data.question, answer: f!.data.answer }));

const searchExamples = ['Paracetamol', 'Amoxicillin', 'Omeprazole', 'Metformin', 'Azithromycin', 'Dolutegravir'];

const steps = [
  { t: 'Send your requirement', d: 'Product or product list, destination and quantity.' },
  { t: 'Supply and regulatory review', d: 'We match partners and check export and destination status.' },
  { t: 'Written quotation', d: 'Pricing, MOQ, packaging and lead time in writing.' },
  { t: 'Documents and shipment', d: 'Documentation prepared and shipped against agreed Incoterms.' },
];

const credentialLayers = [
  { icon: 'building', t: 'PharmaXports', d: 'Our own company details and licences are shown only where verified and configured.' },
  { icon: 'flask', t: 'Manufacturing partners', d: 'GMP certificates and licences belong to each manufacturer. Provided on request, per product.' },
  { icon: 'document', t: 'Product documents', d: 'Certificate of Analysis, specification and COPP where issued, per batch or product.' },
  { icon: 'globe', t: 'Destination rules', d: 'Import authority and registration requirements are checked per country before quoting.' },
];
---

<BaseLayout
  title="PharmaXports | Global Pharmaceutical Sourcing Partner from India"
  description="PharmaXports is a B2B pharmaceutical sourcing and export platform. Discover formulations, APIs, medical devices and healthcare supplies through Indian manufacturing partners and request a quotation."
>
  <!-- 3. HERO -->
  <section class="bg-white border-b border-slate-200">
    <div class="container-page py-12 sm:py-16 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="eyebrow">B2B pharmaceutical sourcing · India</p>
        <h1 class="mt-3 text-4xl sm:text-5xl leading-[1.08] text-[color:var(--color-navy)]">Your Global Pharmaceutical Sourcing Partner from India</h1>
        <span class="gold-rule mt-5"></span>
        <p class="mt-5 text-lg text-slate-600 max-w-xl leading-relaxed">
          Discover pharmaceutical formulations, APIs, medical devices and healthcare supplies through Indian manufacturing partners.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/request-quote/" class="btn btn-primary btn-lg">Request a Quote <Icon name="arrow-right" class="w-4 h-4" /></a>
          <a href="/products/" class="btn btn-outline btn-lg">Explore Products</a>
        </div>
        <ul class="mt-8 grid sm:grid-cols-3 gap-4 text-sm">
          <li class="flex gap-2.5"><Icon name="building" class="w-5 h-5 text-[color:var(--color-teal)] shrink-0" /><span><strong class="block text-[color:var(--color-navy)]">Merchant exporter</strong><span class="text-slate-500">Sourced from partner manufacturers</span></span></li>
          <li class="flex gap-2.5"><Icon name="user-group" class="w-5 h-5 text-[color:var(--color-teal)] shrink-0" /><span><strong class="block text-[color:var(--color-navy)]">Licensed B2B buyers</strong><span class="text-slate-500">Importers, distributors, tenders</span></span></li>
          <li class="flex gap-2.5"><Icon name="document" class="w-5 h-5 text-[color:var(--color-teal)] shrink-0" /><span><strong class="block text-[color:var(--color-navy)]">Written quotations</strong><span class="text-slate-500">Documents supplied on request</span></span></li>
        </ul>
      </div>
      <HeroIllustration />
    </div>
  </section>

  <!-- 4. PRODUCT / MOLECULE SEARCH -->
  <section class="bg-[color:var(--color-navy)]" aria-labelledby="home-search-title">
    <div class="container-page py-8 sm:py-10">
      <h2 id="home-search-title" class="text-lg sm:text-xl font-bold text-white">Find a product, molecule or HS code</h2>
      <form action="/products/" method="get" role="search" class="mt-4 flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <Icon name="search" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-500" />
          <label for="home-q" class="sr-only">Search product, molecule or HS code</label>
          <input id="home-q" type="search" name="q" placeholder="e.g. Amoxicillin, Metformin, 3004" class="field !pl-12 !py-3.5 !border-0" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary btn-lg">Search catalogue</button>
      </form>
      <div class="mt-4 flex flex-wrap gap-2" aria-label="Example searches">
        {searchExamples.map((ex) => <a href={`/products/?q=${encodeURIComponent(ex)}`} class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-white hover:bg-white/20 min-h-[32px] inline-flex items-center">{ex}</a>)}
      </div>
    </div>
  </section>

  <!-- 5. EIGHT CATEGORIES -->
  <section class="container-page py-14 sm:py-16">
    <div class="flex items-end justify-between flex-wrap gap-3 mb-8">
      <div>
        <p class="eyebrow">Product categories</p>
        <h2 class="section-title mt-2">Eight categories, one sourcing desk</h2>
      </div>
      <a href="/products/" class="text-sm font-semibold text-[color:var(--color-teal-dark)] hover:underline inline-flex items-center gap-1">All products <Icon name="arrow-right" class="w-3.5 h-3.5" /></a>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {categoryGroups.map((c) => (
        <a href={`/products/${c.id}/`} class="card card-hover p-4 sm:p-5 flex flex-col">
          <span class="grid place-items-center w-10 h-10 rounded-lg bg-[color:var(--color-blue-light)] text-[color:var(--color-teal-dark)]"><Icon name={c.icon} class="w-5 h-5" /></span>
          <h3 class="mt-3 font-bold text-[color:var(--color-navy)] leading-snug">{c.name}</h3>
          <p class="mt-1 text-sm text-slate-600 leading-snug flex-1">{c.shortDescription}</p>
          <span class="mt-3 text-xs text-slate-500">{categoryCounts[c.id]} classes tracked</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 6. FEATURED SOURCING-READY PRODUCTS -->
  <section class="bg-white border-y border-slate-100">
    <div class="container-page py-14 sm:py-16">
      <div class="flex items-end justify-between flex-wrap gap-3 mb-8">
        <div>
          <p class="eyebrow">Featured products</p>
          <h2 class="section-title mt-2">Products you can request a quote for today</h2>
          <p class="section-lead mt-2 text-sm">Each product page lists export and prescription status. Availability and pricing are confirmed per enquiry.</p>
        </div>
        <a href="/products/" class="text-sm font-semibold text-[color:var(--color-teal-dark)] hover:underline inline-flex items-center gap-1">View catalogue <Icon name="arrow-right" class="w-3.5 h-3.5" /></a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredProducts.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- 7. MOLECULE DISCOVERY -->
  <section class="container-page py-14 sm:py-16">
    <div class="grid lg:grid-cols-3 gap-8 items-start">
      <div>
        <p class="eyebrow">Molecule discovery</p>
        <h2 class="section-title mt-2">Browse by therapeutic class</h2>
        <p class="section-lead mt-3 text-sm">The molecule index covers more than 2,400 molecules. A molecule appearing in the index is a sourcing starting point: availability from a manufacturing partner is confirmed per enquiry.</p>
        <a href="/products/molecules/" class="btn btn-navy mt-5">Open molecule index</a>
      </div>
      <div class="lg:col-span-2 flex flex-wrap gap-2.5">
        {topClasses.map((c) => (
          <a href={`/products/therapeutic-class/${c.id}/`} class="card card-hover px-4 py-3 min-w-[12rem] flex-1 basis-[12rem]">
            <span class="block text-sm font-semibold text-[color:var(--color-navy)] leading-snug">{c.name}</span>
            <span class="block text-xs text-slate-500 mt-0.5">{c.listedCount} molecules · HS {c.hsCode}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. INTERNATIONAL MARKETS -->
  <section class="bg-[color:var(--color-blue-light)]">
    <div class="container-page py-14 sm:py-16">
      <div class="flex items-end justify-between flex-wrap gap-3 mb-8">
        <div>
          <p class="eyebrow">International markets</p>
          <h2 class="section-title mt-2">Regulatory pathway by region</h2>
          <p class="section-lead mt-2 text-sm">Requirements differ by product and destination. Region pages summarise buyer types, authorities and documents. Registration is never guaranteed.</p>
        </div>
        <a href="/markets/" class="text-sm font-semibold text-[color:var(--color-teal-dark)] hover:underline inline-flex items-center gap-1">All markets <Icon name="arrow-right" class="w-3.5 h-3.5" /></a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-4">
        {markets.map((m) => <MarketCard id={m.data.id} name={m.data.name} character={m.data.character} skylineVariant={marketSkyline[m.data.id]} />)}
      </div>
    </div>
  </section>

  <!-- 9. WHY PHARMAXPORTS -->
  <section class="container-page py-14 sm:py-16">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <p class="eyebrow">Why PharmaXports</p>
        <h2 class="section-title mt-2">Built for licensed international buyers</h2>
        <p class="section-lead mt-4">We operate as a merchant exporter: we source from Indian manufacturing partners and do not manufacture in-house. Every enquiry is structured around verified product information, honest regulatory context and complete export documentation.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
        <TrustPillar icon="building" title="Partner network" description="Formulations, APIs, biologicals and devices sourced through Indian manufacturing partners." />
        <TrustPillar icon="shield-check" title="Regulatory awareness" description="Export and prescription status checked per product and destination, not assumed from a listing." />
        <TrustPillar icon="document" title="Documentation support" description="COPP, Certificate of Analysis and GMP certificates requested per consignment from the manufacturer." />
        <TrustPillar icon="truck" title="Bulk and institutional supply" description="Wholesale, tender and institutional volumes coordinated with partners." />
      </div>
    </div>
  </section>

  <!-- 10. BUYER-SPECIFIC SOLUTIONS -->
  <section class="bg-white border-y border-slate-100">
    <div class="container-page py-14 sm:py-16">
      <div class="flex items-end justify-between flex-wrap gap-3 mb-8">
        <div>
          <p class="eyebrow">Buyer solutions</p>
          <h2 class="section-title mt-2">Sourcing built around how you buy</h2>
        </div>
        <a href="/buyers/" class="text-sm font-semibold text-[color:var(--color-teal-dark)] hover:underline inline-flex items-center gap-1">All buyer solutions <Icon name="arrow-right" class="w-3.5 h-3.5" /></a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {buyerSegments.map((b) => (
          <a href={`/buyers/${b.slug}/`} class="card card-hover p-5 flex flex-col">
            <h3 class="font-bold text-[color:var(--color-navy)]">{b.navLabel}</h3>
            <p class="mt-1.5 text-sm text-slate-600 leading-snug flex-1">{b.summary}</p>
            <span class="mt-3 text-sm font-semibold text-[color:var(--color-teal-dark)] inline-flex items-center gap-1">Learn more <Icon name="arrow-right" class="w-3.5 h-3.5" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. HOW SOURCING WORKS -->
  <section class="container-page py-14 sm:py-16">
    <p class="eyebrow">How sourcing works</p>
    <h2 class="section-title mt-2">From requirement to shipment in four steps</h2>
    <ol class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-0 relative">
      {steps.map((s, i) => (
        <li class="relative pr-6 pb-6 lg:pb-0">
          <span class="grid place-items-center w-9 h-9 rounded-full bg-[color:var(--color-navy)] text-white text-sm font-bold">{i + 1}</span>
          <span class="hidden lg:block absolute top-[1.1rem] left-11 right-2 h-px bg-[color:var(--color-gold)]/70" aria-hidden={i === steps.length - 1 ? 'true' : undefined} hidden={i === steps.length - 1}></span>
          <h3 class="mt-3 font-bold text-[color:var(--color-navy)]">{s.t}</h3>
          <p class="mt-1 text-sm text-slate-600 leading-snug">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 12. COMPLIANCE AND DOCUMENTATION -->
  <section class="bg-[color:var(--color-navy)] text-white">
    <div class="container-page py-14 sm:py-16">
      <div class="flex items-end justify-between flex-wrap gap-3 mb-8">
        <div>
          <p class="text-xs font-bold tracking-[0.14em] uppercase text-[color:var(--color-gold)]">Quality and compliance</p>
          <h2 class="mt-2 text-2xl sm:text-3xl text-white">Who holds which credential</h2>
          <p class="mt-2 text-white/75 max-w-2xl text-sm">We keep four layers separate so a manufacturer&rsquo;s certificate is never presented as ours.</p>
        </div>
        <a href="/compliance/" class="btn btn-outline !bg-transparent !text-white !border-white hover:!bg-white hover:!text-[color:var(--color-navy)]">Compliance centre</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {credentialLayers.map((c) => (
          <div class="rounded-xl border border-white/15 bg-white/5 p-5">
            <Icon name={c.icon} class="w-6 h-6 text-[color:var(--color-gold)]" />
            <h3 class="mt-3 font-bold text-white">{c.t}</h3>
            <p class="mt-1 text-sm text-white/75 leading-snug">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 13. RFQ -->
  <section id="get-quote" class="bg-[color:var(--color-bg)]">
    <div class="container-page py-14 sm:py-16 grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-2">
        <p class="eyebrow">Request a quote</p>
        <h2 class="section-title mt-2">Looking for bulk pharmaceutical supply?</h2>
        <p class="section-lead mt-3 text-sm">Tell us the product, destination and quantity. We review supply and regulatory considerations before replying with a written quotation. A reference number appears only after your enquiry has been accepted.</p>
        <p class="mt-4 text-sm text-slate-600">Several products? Use the <a href="/inquiry/" class="underline text-[color:var(--color-teal-dark)]">RFQ list</a> or attach an Excel or PDF list.</p>
      </div>
      <div class="lg:col-span-3"><QuoteForm /></div>
    </div>
  </section>

  <!-- 14. RESOURCES -->
  <section class="container-page py-14 sm:py-16">
    <div class="flex items-end justify-between flex-wrap gap-3 mb-8">
      <div>
        <p class="eyebrow">Resources</p>
        <h2 class="section-title mt-2">Export guides for buyers</h2>
      </div>
      <a href="/resources/" class="text-sm font-semibold text-[color:var(--color-teal-dark)] hover:underline inline-flex items-center gap-1">All resources <Icon name="arrow-right" class="w-3.5 h-3.5" /></a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredResources.map((r) => (
        <a href={`/resources/${r.id}/`} class="card card-hover p-5 flex flex-col">
          <span class="eyebrow">{r.data.category}</span>
          <h3 class="mt-2 font-bold text-[color:var(--color-navy)] leading-snug">{r.data.title}</h3>
          <p class="mt-2 text-sm text-slate-600 leading-snug flex-1">{r.data.excerpt}</p>
          <span class="mt-3 text-sm font-semibold text-[color:var(--color-teal-dark)] inline-flex items-center gap-1">Read <Icon name="arrow-right" class="w-3.5 h-3.5" /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- 15. FAQ -->
  <section class="bg-white border-t border-slate-100">
    <div class="container-page py-14 sm:py-16 max-w-3xl">
      <p class="eyebrow">FAQ</p>
      <h2 class="section-title mt-2 mb-6">Common questions</h2>
      <Accordion items={homeFaqs} idPrefix="home-faq" />
      <p class="mt-6"><a href="/faqs/" class="btn btn-ghost">View all FAQs</a></p>
    </div>
  </section>
</BaseLayout>
