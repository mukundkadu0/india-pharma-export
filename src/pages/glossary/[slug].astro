---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const terms = await getCollection('glossary');
  return terms.map((t) => ({ params: { slug: t.data.id }, props: { term: t.data } }));
}

const { term } = Astro.props;
const allTerms = (await getCollection('glossary')).map((t) => t.data);
const related = (term.relatedTerms ?? []).map((id: string) => allTerms.find((t) => t.id === id)).filter(Boolean);

const definedTermJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term.term,
  description: term.definition,
};
---

<BaseLayout title={`${term.term} — Glossary`} description={term.shortDef}>
  <script type="application/ld+json" set:html={JSON.stringify(definedTermJsonLd)} />

  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Glossary', href: '/glossary/' }, { label: term.term }]} />
  </div>

  <article class="container-page pt-6 pb-16 max-w-2xl">
    <h1 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)]">{term.term}</h1>
    <p class="mt-3 text-lg text-slate-600 leading-relaxed">{term.shortDef}</p>

    <div class="mt-8 prose-body">
      <h2>Definition</h2>
      <p>{term.definition}</p>
      <h2>Why It Matters</h2>
      <p>{term.whyItMatters}</p>
    </div>

    {related.length > 0 && (
      <div class="mt-10 pt-8 border-t border-slate-200">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Related Terms</p>
        <div class="flex flex-wrap gap-2">
          {related.map((r: any) => (
            <a href={`/glossary/${r.id}/`} class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200">
              {r.term} <Icon name="arrow-right" class="w-3 h-3" />
            </a>
          ))}
        </div>
      </div>
    )}
  </article>
</BaseLayout>
