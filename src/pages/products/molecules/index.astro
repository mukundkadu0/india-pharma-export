---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import { categoryGroups } from '../../../data/taxonomy';
import { listableMolecules } from '../../../lib/molecules';

const molecules = (await getCollection('molecules')).map((m) => m.data);
const classes = (await getCollection('classes')).map((c) => c.data);
const pageIds = new Set(listableMolecules(molecules, classes, (await getCollection('products')).map((p) => p.data)).map((m) => m.id));
const classById = Object.fromEntries(classes.map((c) => [c.id, c]));
const categoryById = Object.fromEntries(categoryGroups.map((c) => [c.id, c]));

const sorted = [...molecules].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="Molecule Index — Full Catalogue of 2,400+ Exportable Molecules"
  description="Search and filter PharmaXports' full molecule catalogue across formulations, APIs, biologicals, AYUSH and nutraceuticals, sourced from an industry reference compiled September 2026."
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Products', href: '/products/' }, { label: 'Molecule Index' }]} />
  </div>

  <section class="container-page pt-6 pb-10">
    <p class="eyebrow">Molecule Index</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-[color:var(--color-navy)] max-w-2xl">Search the Full Molecule Catalogue</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">
      {sorted.length.toLocaleString()} molecules across 36 therapeutic classes. Narcotics, psychotropics and other Schedule X / NDPS-controlled molecules are excluded from this list — enquire directly if you have a specific case-by-case requirement.
    </p>
    <p class="mt-3 text-sm text-slate-600 max-w-2xl rounded-lg border border-slate-200 bg-white p-3">
      <strong class="text-[color:var(--color-navy)]">How to read this index:</strong> a listed molecule is one we track for export enquiries. It is not a statement of stock or of a confirmed manufacturer.
      For specified products with strength, form and packaging, use the <a href="/products/" class="font-semibold text-[color:var(--color-teal-dark)] underline">product catalogue</a>.
    </p>
  </section>

  <section class="container-page pb-20">
    <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 mb-6 sm:sticky sm:top-[4.5rem] z-10">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <Icon name="search" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500" />
          <input
            id="mi-search"
            type="text"
            placeholder="Search molecule name…"
            class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]"
          />
        </div>
        <div class="relative sm:w-64">
          <select
            id="mi-class"
            aria-label="Filter by therapeutic class"
            class="w-full appearance-none rounded-lg border border-slate-300 bg-white pl-3 pr-9 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]"
          >
            <option value="">All Therapeutic Classes</option>
            {classes.map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
          <Icon name="chevron-down" class="w-4 h-4 absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none" />
        </div>
      </div>

      <div class="flex gap-2 mt-4 overflow-x-auto -mx-4 px-4 pb-1 sm:mx-0 sm:px-0 sm:pb-0 sm:flex-wrap sm:overflow-visible [scrollbar-width:none]">
        <button
          type="button"
          class="mi-tab shrink-0 whitespace-nowrap inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-medium border-slate-300 text-slate-600 data-[active=true]:bg-[color:var(--color-navy)] data-[active=true]:text-white data-[active=true]:border-[color:var(--color-navy)]"
          data-category=""
          data-active="true"
        >
          All Categories
        </button>
        {categoryGroups.map((c) => (
          <button
            type="button"
            class="mi-tab shrink-0 whitespace-nowrap inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-medium border-slate-300 text-slate-600 data-[active=true]:bg-[color:var(--color-navy)] data-[active=true]:text-white data-[active=true]:border-[color:var(--color-navy)]"
            data-category={c.id}
            data-active="false"
          >
            <Icon name={c.icon} class="w-3.5 h-3.5" /> {c.name}
          </button>
        ))}
      </div>

      <p id="mi-count" class="text-xs text-slate-500 mt-3"></p>
    </div>

    <div class="border border-slate-200 rounded-2xl overflow-hidden">
      <div id="mi-list" class="divide-y divide-slate-100">
        {sorted.map((m) => {
          const cls = classById[m.classId];
          const cat = categoryById[m.categoryGroup];
          return (
            <div
              class="mi-row flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 px-4 py-3 hover:bg-slate-50 transition-colors [content-visibility:auto] [contain-intrinsic-size:auto_132px] sm:[contain-intrinsic-size:auto_68px]"
              data-search={m.name.toLowerCase()}
              data-category={m.categoryGroup}
              data-class={m.classId}
            >
              <span class="hidden sm:grid shrink-0 place-items-center w-8 h-8 rounded-lg bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)]">
                <Icon name={cat?.icon ?? 'capsule'} class="w-4 h-4" />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-[color:var(--color-ink)] sm:truncate">
                  {pageIds.has(m.id) ? <a href={`/products/${m.id}/`} class="inline-block py-1.5 hover:text-[color:var(--color-blue)] hover:underline">{m.name}</a> : m.name}
                </p>
                <div class="flex flex-wrap items-center gap-x-1.5">
                  <a href={`/products/therapeutic-class/${m.classId}/#mol-${m.id}`} class="inline-flex items-center min-h-[28px] py-1 text-xs text-slate-600 hover:text-[color:var(--color-teal-dark)] hover:underline sm:truncate">
                    {cls?.name ?? m.classId}
                  </a>
                  {cat && <span class="hidden sm:inline text-xs text-slate-300">·</span>}
                  {cat && <span class="hidden sm:inline text-xs text-slate-500 truncate">{cat.name}</span>}
                </div>
                {m.flag && (
                  <p class="inline-flex items-center text-[11px] font-medium text-amber-800 bg-[color:var(--color-warning)]/10 border border-[color:var(--color-warning)]/30 rounded-full px-2 py-0.5 mt-2">
                    {m.flag}
                  </p>
                )}
              </div>
              <div class="sm:shrink-0 flex flex-wrap items-center gap-1.5">
                {m.buyDirect && (
                  <button
                    type="button"
                    class="add-to-cart inline-flex items-center gap-1 text-xs font-semibold text-white bg-[color:var(--color-teal-dark)] hover:bg-[#0a5f5d] rounded-md px-2.5 py-1.5"
                    data-id={m.id}
                    data-name={m.name}
                    data-meta={cls?.name ?? ''}
                  >
                    <Icon name="cart" class="w-3.5 h-3.5" /> Buy Now
                  </button>
                )}
                <button
                  type="button"
                  class="open-bulk-rfq inline-flex items-center text-xs font-semibold text-white bg-[color:var(--color-navy)] hover:bg-[color:var(--color-navy-deep)] rounded-md px-2.5 py-1.5"
                  data-product={m.name}
                >
                  Request Bulk Quote
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
    <p id="mi-empty" class="hidden text-center text-slate-500 py-16">
      No molecules match your filters. Try clearing a filter, or <a href="/request-quote/" class="text-[color:var(--color-blue)] underline">send us your requirement directly</a>.
    </p>
  </section>
</BaseLayout>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.mi-row'));
  const searchInput = document.getElementById('mi-search') as HTMLInputElement | null;
  const classSelect = document.getElementById('mi-class') as HTMLSelectElement | null;
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('.mi-tab'));
  const countEl = document.getElementById('mi-count');
  const listEl = document.getElementById('mi-list');
  const emptyEl = document.getElementById('mi-empty');

  let activeCategory = '';

  function applyFilters() {
    const q = (searchInput?.value ?? '').trim().toLowerCase();
    const cls = classSelect?.value ?? '';

    let visible = 0;
    rows.forEach((row) => {
      const matchesQ = !q || (row.dataset.search ?? '').includes(q);
      const matchesCategory = !activeCategory || row.dataset.category === activeCategory;
      const matchesClass = !cls || row.dataset.class === cls;
      const show = matchesQ && matchesCategory && matchesClass;
      row.style.display = show ? '' : 'none';
      if (show) visible += 1;
    });

    if (countEl) countEl.textContent = `${visible.toLocaleString()} of ${rows.length.toLocaleString()} molecules shown`;
    emptyEl?.classList.toggle('hidden', visible !== 0);
    listEl?.classList.toggle('hidden', visible === 0);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activeCategory = tab.dataset.category ?? '';
      tabs.forEach((t) => t.setAttribute('data-active', String(t === tab)));
      applyFilters();
    });
  });

  [searchInput, classSelect].forEach((el) => el?.addEventListener('input', applyFilters));

  const params = new URLSearchParams(window.location.search);
  const initialQ = params.get('q');
  if (initialQ && searchInput) searchInput.value = initialQ;

  applyFilters();
</script>
