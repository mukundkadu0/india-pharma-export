---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ClassCard from '../../components/ClassCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTASection from '../../components/CTASection.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CommerceCtas from '../../components/CommerceCtas.astro';
import MoleculePage from '../../components/MoleculePage.astro';
import { listableMolecules } from '../../lib/molecules';
import { categoryGroups, getCategoryGroup, exportStatusMeta, prescriptionStatusMeta, marketMeta } from '../../data/taxonomy';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const classes = await getCollection('classes');

  const categoryPaths = categoryGroups.map((c) => ({
    params: { slug: c.id },
    props: { type: 'category' as const, categoryId: c.id },
  }));

  const productPaths = products.map((p) => ({
    params: { slug: p.data.id },
    props: { type: 'product' as const, product: p.data },
  }));

  const allMolecules = (await getCollection('molecules')).map((m) => m.data);
  const classData = classes.map((c) => c.data);
  const classById = Object.fromEntries(classData.map((c) => [c.id, c]));
  const listable = listableMolecules(allMolecules, classData, products.map((p) => p.data));
  const byClass: Record<string, typeof listable> = {};
  for (const m of listable) (byClass[m.classId] ??= []).push(m);

  const moleculePaths = listable.map((m) => {
    const pool = byClass[m.classId];
    const i = pool.indexOf(m);
    // Up to 12 neighbours (rotating through the class) keeps every page linked without bloating it.
    const siblings = Array.from({ length: Math.min(12, pool.length - 1) }, (_, k) => pool[(i + 1 + k) % pool.length]).map((s) => ({ id: s.id, name: s.name }));
    return {
      params: { slug: m.id },
      props: { type: 'molecule' as const, molecule: m, moleculeClass: classById[m.classId], siblings },
    };
  });

  return [...categoryPaths, ...productPaths, ...moleculePaths];
}

const { type } = Astro.props;
const allProducts = (await getCollection('products')).map((p) => p.data);
const allClasses = (await getCollection('classes')).map((c) => c.data);
---

{type === 'molecule' && (
  <MoleculePage molecule={Astro.props.molecule} classData={Astro.props.moleculeClass} siblings={Astro.props.siblings} />
)}

{type === 'category' && (() => {
  const category = getCategoryGroup(Astro.props.categoryId)!;
  const classesInCategory = allClasses.filter((c) => c.categoryGroup === category.id);
  const productsInCategory = allProducts.filter((p) => p.category === category.id);
  return (
    <BaseLayout
      title={`${category.name} — Pharmaceutical Export from India`}
      description={`${category.shortDescription} Browse ${category.name.toLowerCase()} available for B2B export from India, sourced from WHO-GMP certified manufacturing partners.`}
    >
      <div class="container-page pt-6">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Products', href: '/products/' }, { label: category.name }]} />
      </div>
      <section class="container-page pt-6 pb-12">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent-dark)] mb-3">Product Category</p>
        <h1 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] max-w-2xl">{category.name}</h1>
        <p class="mt-3 text-slate-600 max-w-2xl">{category.shortDescription}</p>
      </section>

      {classesInCategory.length > 0 && (
        <section class="container-page pb-14">
          <h2 class="font-display text-2xl text-[color:var(--color-navy)] mb-5">Therapeutic Classes</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {classesInCategory.map((c) => <ClassCard {...c} />)}
          </div>
        </section>
      )}

      <section class="container-page pb-20">
        <h2 class="font-display text-2xl text-[color:var(--color-navy)] mb-5">Products in This Category</h2>
        {productsInCategory.length > 0 ? (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {productsInCategory.map((p) => <ProductCard {...p} />)}
          </div>
        ) : (
          <div class="rounded-2xl border border-slate-200 p-8 text-center text-slate-500">
            <p>Specific product listings in this category are added as buyer demand is confirmed.</p>
            <Button href="/request-quote/" class="mt-4" variant="secondary">Send Us Your Requirement</Button>
          </div>
        )}
      </section>

      <CTASection
        heading="Don't See What You're Looking For?"
        body="Send us your specific requirement and we'll confirm suitable products and manufacturing partners."
        primaryLabel="Request a Quote"
        primaryHref="/request-quote/"
      />
    </BaseLayout>
  );
})()}

{type === 'product' && (() => {
  const product = Astro.props.product;
  const category = getCategoryGroup(product.category);
  const productClass = allClasses.find((c) => c.id === product.therapeuticClass);
  const es = exportStatusMeta[product.exportStatus];
  const ps = prescriptionStatusMeta[product.prescriptionStatus];
  const related = (product.relatedProducts ?? [])
    .map((id: string) => allProducts.find((p) => p.id === id))
    .filter(Boolean)
    .slice(0, 4);

  const productJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.description,
    sku: product.id,
    category: category?.name,
  };
  const faqJsonLd = product.faqs?.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: product.faqs.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
  return (
    <BaseLayout title={product.seoTitle} description={product.seoDescription} ogType="product">
      <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
      {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

      <div class="container-page pt-6">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Products', href: '/products/' },
            { label: category?.name ?? 'Products', href: `/products/${product.category}/` },
            { label: product.name },
          ]}
        />
      </div>

      <section class="container-page pt-6 pb-14 grid lg:grid-cols-5 gap-10" data-product-view={product.id} data-product-name={product.name}>
        <div class="lg:col-span-3">
          <div class="flex flex-wrap gap-2 mb-4">
            <Badge label={category?.name ?? ''} className="bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)] border-transparent normal-case" size="md" />
            <Badge label={es.label} className={es.className} size="md" />
            <Badge label={ps.label} className={ps.className} size="md" />
          </div>
          <h1 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] leading-tight">{product.name}</h1>
          <p class="mt-2 text-lg text-slate-500">{product.genericName}</p>

          <img
            src={`/images/products/${product.id}.webp`}
            alt={`${product.name} export pack illustration`}
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
            class="mt-6 w-full max-w-md rounded-2xl ring-1 ring-slate-900/5"
          />
          <p class="mt-2 text-xs text-slate-500">Illustrative pack image. Actual pack and artwork are confirmed per order.</p>

          <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4">
            {[
              { icon: 'building', label: 'Partner-manufactured. Partner confirmed per enquiry' },
              { icon: 'globe', label: `Listed regions: ${product.marketRegions.map((m: string) => marketMeta[m]?.flagLabel ?? m).join(', ')}` },
              { icon: 'document', label: 'GMP and analysis documents on request' },
              { icon: 'quote', label: 'Quoted per quantity and destination' },
            ].map((t) => (
              <div class="flex flex-col items-start gap-2 p-3 rounded-lg bg-[color:var(--color-bg)] border border-slate-200">
                <Icon name={t.icon} class="w-5 h-5 text-[color:var(--color-navy)]" />
                <span class="text-xs font-medium text-slate-600 leading-snug">{t.label}</span>
              </div>
            ))}
          </div>

          <div class="mt-10 prose-body">
            <h2>Product Overview</h2>
            <p>{product.description}</p>
            {product.keyPoints?.length > 0 && (
              <>
                <h2>Key Points</h2>
                <ul>
                  {product.keyPoints.map((k: string) => (
                    <li class="flex items-start gap-2">
                      <Icon name="check" class="w-4 h-4 text-[color:var(--color-success)] mt-0.5 shrink-0" /> <span>{k}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>

          <div class="mt-10 grid sm:grid-cols-2 gap-8">
            <div>
              <h2 class="font-display text-xl text-[color:var(--color-navy)] mb-3">Quick Specifications</h2>
              <table class="w-full text-sm border border-slate-200 rounded-xl overflow-hidden">
                <tbody>
                  {[
                    ['Generic Name', product.genericName],
                    ['Dosage Form', product.dosageForm],
                    ['Strength', product.strength],
                    ['HS Code', product.hsCode],
                    ['Packaging', product.packaging],
                    ['Export classification', es.label],
                    ['Prescription classification', ps.label],
                    ['MOQ', product.moq],
                    ...(product.shelfLife ? [['Shelf Life', product.shelfLife]] : []),
                    ...(product.storage ? [['Storage', product.storage]] : []),
                  ].map(([k, v]) => (
                    <tr class="border-t border-slate-100 first:border-0 odd:bg-slate-50/60">
                      <th class="text-left font-medium text-slate-500 px-3 py-2.5 w-2/5 align-top">{k}</th>
                      <td class="px-3 py-2.5 text-slate-700 align-top">{v}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div>
              <h2 class="font-display text-xl text-[color:var(--color-navy)] mb-3">Regulatory Information</h2>
              <div class="rounded-xl border border-slate-200 p-4 space-y-3">
                <div class="flex items-center gap-2 flex-wrap">
                  <Badge label={ps.label} className={ps.className} />
                </div>
                <p class="text-sm text-slate-600 leading-relaxed">{product.regulatoryNotes}</p>
                {productClass && (
                  <a href={`/products/therapeutic-class/${productClass.id}/`} class="inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-blue)] hover:underline">
                    View {productClass.name} class details <Icon name="arrow-right" class="w-3.5 h-3.5" />
                  </a>
                )}
              </div>
              <div class="mt-4 rounded-xl bg-amber-50 border border-amber-200 p-4 text-xs text-amber-800 leading-relaxed">
                Requirements vary by destination. Verify current requirements with the relevant authority before shipment. See our <a href="/compliance/" class="underline font-medium">Compliance</a> page.
              </div>
            </div>
          </div>

          <div class="mt-10 grid sm:grid-cols-2 gap-8">
            <div>
              <h2 class="font-display text-xl text-[color:var(--color-navy)] mb-3">Destination considerations</h2>
              <p class="text-sm text-slate-600 leading-relaxed">Regions below are listed in our catalogue data for this product. A listing is not a registration or a guarantee of supply. Import authority, registration status and labelling are checked per destination before we quote.</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {product.marketRegions.map((m: string) => (
                  <li><a href={`/markets/${m}/`} class="chip hover:border-[color:var(--color-teal)]">{marketMeta[m]?.flagLabel ?? m}</a></li>
                ))}
              </ul>
            </div>
            <div>
              <h2 class="font-display text-xl text-[color:var(--color-navy)] mb-3">Documentation available on request</h2>
              <ul class="space-y-2 text-sm text-slate-700">
                {['Certificate of Analysis (per batch)', 'Product specification and shelf-life data', 'GMP certificate and manufacturing licence of the partner site', 'COPP, where issued for the product'].map((d) => (
                  <li class="flex gap-2"><Icon name="document" class="w-4 h-4 mt-0.5 text-[color:var(--color-teal)] shrink-0" />{d}</li>
                ))}
              </ul>
              <p class="mt-2 text-xs text-slate-500">These belong to the manufacturing partner, not to PharmaXports.</p>
            </div>
          </div>

          {product.faqs?.length > 0 && (
            <div class="mt-10">
              <h2 class="font-display text-xl text-[color:var(--color-navy)] mb-3">Quick Answers</h2>
              <div class="space-y-4">
                {product.faqs.map((f: { q: string; a: string }) => (
                  <div class="rounded-xl border border-slate-200 p-4">
                    <p class="font-medium text-[color:var(--color-ink)]">{f.q}</p>
                    <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{f.a}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <div class="lg:col-span-2">
          <div class="sticky top-24 space-y-4">
            <div class="card p-5 border-t-4 border-t-[color:var(--color-gold)]">
              <h2 class="font-bold text-[color:var(--color-navy)]">Request a bulk quote</h2>
              <p class="mt-1 text-sm text-slate-600">Pricing is quoted per quantity and destination. No price is shown until we confirm supply.</p>
              <form action="/request-quote/" method="get" class="mt-4 space-y-3">
                <input type="hidden" name="product" value={`${product.name} (${product.strength})`} />
                <div>
                  <label for="pq-qty" class="label">Estimated quantity</label>
                  <input id="pq-qty" name="quantity" type="text" class="field" placeholder="e.g. 100,000 tablets" />
                </div>
                <div>
                  <label for="pq-country" class="label">Destination country</label>
                  <input id="pq-country" name="country" type="text" class="field" autocomplete="country-name" />
                </div>
                <button type="submit" class="btn btn-primary w-full">Request Bulk Quote <Icon name="arrow-right" class="w-4 h-4" /></button>
              </form>
              <button
                type="button"
                class="add-to-inquiry btn btn-outline w-full mt-3"
                data-id={product.id}
                data-name={product.name}
                data-meta={product.strength}
              >
                <Icon name="clipboard" class="w-4 h-4" /> Add to RFQ list
              </button>
              <a href="/inquiry/" class="mt-2 block text-center text-xs text-slate-500 underline">View my RFQ list</a>
            </div>
            {product.commerceStatus === 'DTC_AND_BULK' && product.prescriptionStatus === 'otc' && (
              <div class="card p-5">
                <h2 class="text-sm font-bold text-[color:var(--color-navy)]">Direct order (OTC, where available)</h2>
                <div class="mt-3"><CommerceCtas product={product} layout="detail" hideBulk /></div>
              </div>
            )}
            <div class="rounded-2xl border border-slate-200 p-5 text-sm text-slate-600">
              <p class="font-medium text-[color:var(--color-ink)] mb-2">Need documentation first?</p>
              <p>Our team can share a product brochure and manufacturing-partner regulatory summary on request — just mention it in your enquiry.</p>
            </div>
          </div>
        </div>
      </section>

      {related.length > 0 && (
        <section class="bg-slate-50 border-t border-slate-100">
          <div class="container-page py-14">
            <div class="flex items-center justify-between mb-6">
              <h2 class="font-display text-2xl text-[color:var(--color-navy)]">You May Also Be Interested In</h2>
              <a href="/products/" class="text-sm font-semibold text-[color:var(--color-blue)] hover:underline">View All Products →</a>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
              {related.map((p: any) => <ProductCard {...p} compact />)}
            </div>
          </div>
        </section>
      )}

      <section class="container-page py-16">
        <div class="max-w-2xl mx-auto text-center mb-8">
          <h2 class="font-display text-2xl sm:text-3xl text-[color:var(--color-navy)]">Request Pricing for {product.name}</h2>
        </div>
        <div class="max-w-2xl mx-auto">
          <QuoteForm prefillProduct={product.name} />
        </div>
      </section>
    </BaseLayout>
  );
})()}
