---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { buyerSegments } from '../../data/buyers';
---

<BaseLayout
  title="Buyer Solutions — Pharmaceutical Sourcing for Importers, Distributors, Hospitals and Tenders | PharmaXports"
  description="How PharmaXports supports importers, distributors, wholesalers, hospitals, government and tender buyers, NGOs, pharmaceutical manufacturers and pharmacy chains sourcing from India."
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Buyer Solutions' }]} />
  </div>
  <section class="container-page pt-6 pb-16">
    <p class="eyebrow">Buyer solutions</p>
    <h1 class="section-title mt-2 text-3xl sm:text-4xl">Sourcing built around how you buy</h1>
    <span class="gold-rule mt-4"></span>
    <p class="section-lead mt-5">An importer, a hospital and a tender office all need different information and different documents. Pick the segment closest to yours.</p>
    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {buyerSegments.map((b) => (
        <a href={`/buyers/${b.slug}/`} class="card card-hover p-5 flex flex-col">
          <h2 class="font-bold text-[color:var(--color-navy)]">{b.navLabel}</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{b.summary}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-teal-dark)]">View solution <Icon name="arrow-right" class="w-3.5 h-3.5" /></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
