---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { buyerSegments, getBuyerSegment } from '../../data/buyers';
import { getCategoryGroup } from '../../data/taxonomy';

export function getStaticPaths() {
  return buyerSegments.map((b) => ({ params: { slug: b.slug } }));
}
const b = getBuyerSegment(Astro.params.slug!)!;
const cats = b.categories.map((id) => getCategoryGroup(id)!).filter(Boolean);
const quoteHref = `/request-quote/?buyer=${encodeURIComponent(b.name)}`;
const others = buyerSegments.filter((x) => x.slug !== b.slug);
---

<BaseLayout
  title={`${b.navLabel} — Pharmaceutical Sourcing from India | PharmaXports`}
  description={`${b.headline}. ${b.intro}`.slice(0, 300)}
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Buyer Solutions', href: '/buyers/' }, { label: b.navLabel }]} />
  </div>

  <section class="container-page pt-6 pb-10 grid lg:grid-cols-3 gap-8 items-start">
    <div class="lg:col-span-2">
      <p class="eyebrow">Buyer solution · {b.navLabel}</p>
      <h1 class="section-title mt-2 text-3xl sm:text-4xl">{b.headline}</h1>
      <span class="gold-rule mt-4"></span>
      <p class="mt-5 text-lg text-slate-600 leading-relaxed max-w-2xl">{b.intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={quoteHref} class="btn btn-primary btn-lg">{b.cta} <Icon name="arrow-right" class="w-4 h-4" /></a>
        <a href="/products/" class="btn btn-outline btn-lg">Explore products</a>
      </div>
    </div>
    <aside class="card p-5" aria-label="Quick facts">
      <h2 class="text-sm font-bold text-[color:var(--color-navy)] uppercase tracking-wide">Most relevant categories</h2>
      <ul class="mt-3 space-y-2">
        {cats.map((c) => (
          <li><a href={`/products/${c.id}/`} class="flex items-center gap-2.5 text-sm font-medium text-[color:var(--color-navy)] hover:text-[color:var(--color-teal-dark)]">
            <span class="grid place-items-center w-8 h-8 rounded-md bg-[color:var(--color-blue-light)] text-[color:var(--color-teal-dark)]"><Icon name={c.icon} class="w-4 h-4" /></span>{c.name}
          </a></li>
        ))}
      </ul>
    </aside>
  </section>

  <section class="bg-white border-y border-slate-100">
    <div class="container-page py-12 grid md:grid-cols-2 gap-10">
      <div>
        <h2 class="text-xl font-bold text-[color:var(--color-navy)]">What you can source</h2>
        <ul class="mt-4 space-y-2.5">
          {b.sources.map((s) => <li class="flex gap-2.5 text-slate-700"><Icon name="check-circle" class="w-5 h-5 text-[color:var(--color-teal)] shrink-0 mt-0.5" />{s}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[color:var(--color-navy)]">What to include in your enquiry</h2>
        <ul class="mt-4 space-y-2.5">
          {b.submit.map((s) => <li class="flex gap-2.5 text-slate-700"><Icon name="clipboard" class="w-5 h-5 text-[color:var(--color-gold-dark)] shrink-0 mt-0.5" />{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <h2 class="text-xl font-bold text-[color:var(--color-navy)]">How sourcing works for {b.navLabel.toLowerCase()}</h2>
    <ol class="mt-6 grid md:grid-cols-3 gap-5">
      {b.flow.map((s, i) => (
        <li class="card p-5">
          <span class="grid place-items-center w-8 h-8 rounded-full bg-[color:var(--color-navy)] text-white text-sm font-bold">{i + 1}</span>
          <h3 class="mt-3 font-bold text-[color:var(--color-navy)]">{s.title}</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-[color:var(--color-bg)] border-y border-slate-100">
    <div class="container-page py-12 grid md:grid-cols-2 gap-10">
      <div>
        <h2 class="text-xl font-bold text-[color:var(--color-navy)]">Documentation commonly requested</h2>
        <p class="mt-1 text-sm text-slate-500">Available on request, per product. These belong to the manufacturing partner unless stated otherwise; PharmaXports does not hold them itself.</p>
        <ul class="mt-4 space-y-2.5">
          {b.documents.map((d) => <li class="flex gap-2.5 text-slate-700"><Icon name="document" class="w-5 h-5 text-[color:var(--color-teal)] shrink-0 mt-0.5" />{d}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold text-[color:var(--color-navy)]">Quotation and supply matching</h2>
        <p class="mt-4 text-slate-700 leading-relaxed">{b.matching}</p>
        {b.caution && <p class="mt-4 text-sm border-l-4 border-[color:var(--color-gold)] bg-white px-4 py-3 text-slate-700">{b.caution}</p>}
        <p class="mt-4 text-sm text-slate-600">PharmaXports is a merchant exporter and sourcing platform. Product status, export classification and destination rules are checked per enquiry. See <a class="underline text-[color:var(--color-teal-dark)]" href="/compliance/">Quality &amp; Compliance</a>.</p>
      </div>
    </div>
  </section>

  <section class="container-page py-12 text-center">
    <h2 class="text-2xl font-bold text-[color:var(--color-navy)]">Ready to share your requirement?</h2>
    <a href={quoteHref} class="btn btn-primary btn-lg mt-5">{b.cta} <Icon name="arrow-right" class="w-4 h-4" /></a>
    <p class="mt-10 text-sm text-slate-500">Other buyer solutions</p>
    <div class="mt-3 flex flex-wrap justify-center gap-2">
      {others.map((o) => <a href={`/buyers/${o.slug}/`} class="chip hover:border-[color:var(--color-teal)]">{o.navLabel}</a>)}
    </div>
  </section>
</BaseLayout>
