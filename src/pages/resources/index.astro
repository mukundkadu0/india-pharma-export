---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';

const resources = (await getCollection('resources')).sort((a, b) => (a.data.featured ? -1 : 1));
const categories = [...new Set(resources.map((r) => r.data.category))];
---

<BaseLayout
  title="Resources — Pharma Export Guides, Compliance & Market Intelligence"
  description="An editorial knowledge centre for international pharmaceutical buyers: export guides, compliance explainers, HS code references and market intelligence from PharmaXports."
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Resources' }]} />
  </div>

  <section class="container-page pt-6 pb-10">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Buyer Resources</p>
    <h1 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] max-w-2xl">From Product Search to Export Documentation</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">Practical, factual guides for international buyers evaluating pharmaceutical supply from India — market intelligence, compliance explainers, HS codes and documentation.</p>
    <div class="mt-6 flex flex-wrap gap-2">
      {categories.map((c) => <span class="text-xs px-3 py-1.5 rounded-full bg-slate-100 text-slate-600">{c}</span>)}
    </div>
  </section>

  <section class="container-page pb-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {resources.map((r) => (
        <a href={`/resources/${r.id}/`} class={`flex flex-col p-6 rounded-2xl border transition-shadow hover:shadow-lg ${r.data.featured ? 'border-[color:var(--color-accent)]/40 bg-[color:var(--color-blue-light)]' : 'border-slate-200 bg-white'}`}>
          {r.data.featured && <span class="text-[10px] font-bold uppercase tracking-wide text-[color:var(--color-accent)] mb-2">Featured</span>}
          <span class="text-xs font-semibold uppercase tracking-wide text-[color:var(--color-blue)]">{r.data.category}</span>
          <h2 class="mt-2 font-display text-lg text-[color:var(--color-navy)] leading-snug">{r.data.title}</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{r.data.excerpt}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-blue)]">Read More <Icon name="arrow-right" class="w-3.5 h-3.5" /></span>
        </a>
      ))}
    </div>
  </section>

  <CTASection
    heading="Can't Find What You're Looking For?"
    body="Our team can walk you through market and compliance considerations for your specific product."
    primaryLabel="Contact Us"
    primaryHref="/contact/"
  />
</BaseLayout>
