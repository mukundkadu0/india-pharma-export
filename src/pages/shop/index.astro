---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';

const allMolecules = (await getCollection('molecules')).map((m) => m.data);
const classes = (await getCollection('classes')).map((c) => c.data);
const classById = Object.fromEntries(classes.map((c) => [c.id, c]));
const items = allMolecules.filter((m) => m.buyDirect).sort((a, b) => a.name.localeCompare(b.name));

const categoryTabs = [
  { id: '', label: 'All' },
  { id: 'nutraceuticals', label: 'Nutraceuticals & Vitamins' },
  { id: 'ayush', label: 'AYUSH — Ayurveda & Herbal' },
];
---

<BaseLayout
  title="Shop Nutraceuticals & AYUSH Products Direct — India Pharma Export"
  description="Order OTC nutraceuticals, vitamins and AYUSH products directly, no B2B minimum order. Prescription and Schedule H/H1/X products remain quote-only."
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shop OTC & AYUSH' }]} />
  </div>

  <section class="container-page pt-6 pb-8">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[color:var(--color-accent)] mb-3">Direct Order</p>
    <h1 class="font-display text-3xl sm:text-4xl text-[color:var(--color-navy)] max-w-2xl">Shop Nutraceuticals &amp; AYUSH, Direct</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">
      These {items.length} products are non-prescription (OTC) nutraceuticals, vitamins and AYUSH items — add what you need and submit a direct order request, no B2B minimum quantity required.
      Everything else in our catalogue is Schedule H / H1 / X or prescription-only and stays on the <a href="/request-quote/" class="text-[color:var(--color-blue)] underline">B2B quote system</a>.
    </p>
    <div class="mt-4 rounded-xl bg-slate-50 border border-slate-200 p-4 text-sm text-slate-600 max-w-2xl">
      <strong class="text-[color:var(--color-navy)]">How it works:</strong> add products to your cart, submit your details and shipping address — our team confirms pricing, quantity and payment (invoice or bank transfer) directly with you. No online payment is collected on this site.
    </div>
  </section>

  <section class="container-page pb-20">
    <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 mb-6 sm:sticky sm:top-[4.5rem] z-10">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <Icon name="search" class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
          <input
            id="shop-search"
            type="text"
            placeholder="Search product name…"
            class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2.5 text-sm outline-none focus:border-[color:var(--color-blue)]"
          />
        </div>
      </div>
      <div class="flex flex-wrap gap-2 mt-4">
        {categoryTabs.map((t) => (
          <button type="button" class="shop-tab rounded-full border px-4 py-1.5 text-sm font-medium border-slate-300 text-slate-600 data-[active=true]:bg-[color:var(--color-navy)] data-[active=true]:text-white data-[active=true]:border-[color:var(--color-navy)]" data-category={t.id} data-active={t.id === '' ? 'true' : 'false'}>
            {t.label}
          </button>
        ))}
      </div>
      <p id="shop-count" class="text-xs text-slate-500 mt-3"></p>
    </div>

    <div id="shop-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((m) => {
        const cls = classById[m.classId];
        return (
          <div class="shop-item flex items-center justify-between gap-3 rounded-2xl border border-slate-200 p-4" data-search={m.name.toLowerCase()} data-category={m.categoryGroup}>
            <div class="min-w-0">
              <p class="text-sm font-medium text-[color:var(--color-ink)] sm:truncate">{m.name}</p>
              <p class="text-xs text-slate-500 sm:truncate">{cls?.name ?? m.classId}</p>
            </div>
            <div class="shrink-0 flex items-center gap-1.5">
              <button
                type="button"
                class="add-to-cart inline-flex items-center gap-1 text-xs font-semibold text-white bg-[color:var(--color-accent)] hover:bg-[#d9700f] rounded-full px-2.5 py-1.5"
                data-id={m.id}
                data-name={m.name}
                data-meta={cls?.name ?? ''}
              >
                <Icon name="cart" class="w-3.5 h-3.5" /> Buy Now
              </button>
              <a
                href={`/request-quote/?product=${encodeURIComponent(m.name)}`}
                class="inline-flex items-center text-xs font-semibold text-[color:var(--color-navy)] border border-[color:var(--color-navy)] hover:bg-[color:var(--color-blue-light)] rounded-full px-2.5 py-1.5"
              >
                Bulk Order
              </a>
            </div>
          </div>
        );
      })}
    </div>
    <p id="shop-empty" class="hidden text-center text-slate-500 py-16">No products match your search.</p>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('shop-search') as HTMLInputElement | null;
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('.shop-tab'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.shop-item'));
  const countEl = document.getElementById('shop-count');
  const gridEl = document.getElementById('shop-grid');
  const emptyEl = document.getElementById('shop-empty');

  let activeCategory = '';

  function applyFilters() {
    const q = (searchInput?.value ?? '').trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const matchesQ = !q || (row.dataset.search ?? '').includes(q);
      const matchesCategory = !activeCategory || row.dataset.category === activeCategory;
      const show = matchesQ && matchesCategory;
      row.style.display = show ? '' : 'none';
      if (show) visible += 1;
    });
    if (countEl) countEl.textContent = `${visible} of ${rows.length} products shown`;
    emptyEl?.classList.toggle('hidden', visible !== 0);
    gridEl?.classList.toggle('hidden', visible === 0);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activeCategory = tab.dataset.category ?? '';
      tabs.forEach((t) => t.setAttribute('data-active', String(t === tab)));
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);
  applyFilters();
</script>
