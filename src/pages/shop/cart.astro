---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';
---

<BaseLayout
  title="Your OTC Order Request — PharmaXports"
  description="Review the products in your OTC and AYUSH order request and send it to our team."
  noindex
>
  <div class="container-page pt-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'OTC & AYUSH Shop', href: '/shop/' }, { label: 'Your order request' }]} />
  </div>

  <section class="container-page pt-6 pb-10">
    <p class="eyebrow">OTC &amp; AYUSH direct order</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-[color:var(--color-navy)] max-w-2xl">Your order request</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">
      This is a direct order request, not a B2B export enquiry. There is no online payment and no price shown: our team confirms availability, price and payment (invoice or bank transfer) with you before anything ships.
      Looking for bulk or export volumes? Use the <a href="/request-quote/" class="underline text-[color:var(--color-teal-dark)]">B2B quote</a> instead.
    </p>
  </section>

  <section class="container-page pb-20 grid lg:grid-cols-5 gap-10">
    <div class="lg:col-span-2 min-w-0">
      <h2 class="font-bold text-[color:var(--color-navy)] mb-4">Products in this request</h2>
      <div id="cart-items" class="space-y-3"></div>
      <p id="cart-empty" class="hidden state-empty text-sm text-slate-600 p-6 text-center">
        Your order request is empty. Browse the <a href="/shop/" class="text-[color:var(--color-teal-dark)] underline">OTC &amp; AYUSH shop</a> and select "Add to order request".
      </p>
      <button id="clear-cart" type="button" class="hidden mt-3 text-xs text-slate-600 hover:text-[color:var(--color-error)] underline">Clear all</button>
    </div>

    <div class="lg:col-span-3 min-w-0">
      <form id="cart-form" data-endpoint={site.formEndpoint} data-fallback-email={site.email} class="card p-6 sm:p-8" novalidate>
        <input type="hidden" name="orderType" value="Direct Order Request" />
        <p class="text-xs text-slate-500 mb-4">Fields marked * are required.</p>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="co-name" class="label">Full name *</label>
            <input id="co-name" name="fullName" type="text" required autocomplete="name" class="field" />
          </div>
          <div>
            <label for="co-email" class="label">Email *</label>
            <input id="co-email" name="email" type="email" required autocomplete="email" inputmode="email" class="field" />
          </div>
          <div>
            <label for="co-phone" class="label">Phone / WhatsApp *</label>
            <input id="co-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" class="field" />
          </div>
          <div>
            <label for="co-country" class="label">Country *</label>
            <input id="co-country" name="country" type="text" required autocomplete="country-name" class="field" />
          </div>
          <div class="sm:col-span-2">
            <label for="co-address" class="label">Delivery address *</label>
            <textarea id="co-address" name="shippingAddress" rows="3" required autocomplete="street-address" class="field"></textarea>
          </div>
          <div id="co-licence-wrap" class="sm:col-span-2 hidden">
            <label for="co-licence" class="label">Drug / import licence number *</label>
            <input id="co-licence" name="licenceNumber" type="text" class="field" />
            <p class="mt-1.5 text-xs text-slate-500">Required because your request contains a prescription item. We verify it before confirming.</p>
          </div>
          <div class="sm:col-span-2">
            <label for="co-message" class="label">Notes (quantities, preferred packaging, delivery timing)</label>
            <textarea id="co-message" name="message" rows="3" class="field"></textarea>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="co-hp">Leave blank</label>
            <input id="co-hp" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="access_key" value={site.formAccessKey} />
          <input type="hidden" name="subject" value="New Direct Order Request — PharmaXports" />
        </div>
        <p id="co-status" class="mt-4 text-sm hidden" role="status" aria-live="polite"></p>
        <div class="mt-6 flex items-center justify-between flex-wrap gap-3">
          <p class="text-xs text-slate-500 max-w-sm">No payment is collected on this site. Our team confirms price and payment method after reviewing your request.</p>
          <button type="submit" class="btn btn-primary btn-lg">Send order request</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { submitEnquiry, trackRfqSubmit } from '../../lib/rfq-client';
  const CART_STORAGE_KEY = 'ipe-direct-cart';
  type CartItem = { id: string; name: string; meta?: string; rx?: boolean };

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  function readCart(): CartItem[] {
    try {
      const raw = localStorage.getItem(CART_STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }
  function writeCart(list: CartItem[]) {
    try {
      localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(list));
    } catch {
      /* the request still works for this visit; it just won't persist */
    }
    render();
    window.dispatchEvent(new Event('storage'));
  }

  const itemsEl = document.getElementById('cart-items');
  const emptyEl = document.getElementById('cart-empty');
  const clearBtn = document.getElementById('clear-cart');

  function syncLicenceField(list: CartItem[]) {
    const hasRx = list.some((item) => item.rx);
    document.getElementById('co-licence-wrap')?.classList.toggle('hidden', !hasRx);
    const input = document.getElementById('co-licence') as HTMLInputElement | null;
    if (input) input.required = hasRx;
  }

  function render() {
    const list = readCart();
    syncLicenceField(list);
    if (!itemsEl || !emptyEl || !clearBtn) return;
    if (list.length === 0) {
      itemsEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      clearBtn.classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    clearBtn.classList.remove('hidden');
    itemsEl.innerHTML = list
      .map(
        (item, i) => `
      <div class="card flex items-center justify-between gap-3 p-4">
        <div class="min-w-0">
          <p class="text-sm font-semibold text-[color:var(--color-ink)]">${esc(item.name)}${item.rx ? ' <span class="ml-1 align-middle text-[10px] font-semibold uppercase tracking-wide text-slate-700 bg-slate-100 border border-slate-200 rounded px-1.5 py-0.5">Rx</span>' : ''}</p>
          ${item.meta ? `<p class="text-xs text-slate-600">${esc(item.meta)}</p>` : ''}
          <label class="text-xs text-slate-600 mt-2 block" for="qty-${i}">Quantity</label>
          <input id="qty-${i}" data-idx="${i}" class="qty-input field mt-1 w-40 !py-1.5 !text-sm" placeholder="e.g. 2 boxes" />
        </div>
        <button type="button" data-remove="${esc(item.id)}" aria-label="Remove ${esc(item.name)}" class="shrink-0 grid place-items-center w-10 h-10 rounded-md text-slate-500 hover:text-[color:var(--color-error)] hover:bg-slate-50">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="w-5 h-5"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
        </button>
      </div>`
      )
      .join('');

    itemsEl.querySelectorAll('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.remove;
        writeCart(readCart().filter((item) => item.id !== id));
      });
    });
  }

  clearBtn?.addEventListener('click', () => writeCart([]));
  render();

  const form = document.getElementById('cart-form') as HTMLFormElement | null;
  const status = document.getElementById('co-status');
  const setStatus = (msg: string, cls: string) => {
    if (!status) return;
    status.textContent = msg;
    status.className = `mt-4 text-sm ${cls}`;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const honeypot = (form.elements.namedItem('companyWebsite') as HTMLInputElement)?.value;
    if (honeypot) return;

    const list = readCart();
    if (list.length === 0) {
      setStatus('Add at least one product to your order request before sending.', 'text-[color:var(--color-error)]');
      return;
    }

    const qtyInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.qty-input'));
    const productLines = list.map((item, i) => `${item.name}${item.rx ? ' [Rx]' : ''}${qtyInputs[i]?.value ? ` — ${qtyInputs[i].value}` : ''}`);

    const data = new FormData(form);
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    setStatus('Sending…', 'text-slate-600');

    const result = await submitEnquiry(form, 'buyer', form.dataset.endpoint || '', {
      buyerType: 'Direct order (OTC / AYUSH)',
      product: productLines.join('; '),
      quantity: 'As listed against each product',
      message: [
        `Order type: ${data.get('orderType') ?? ''}`,
        `Shipping address: ${data.get('shippingAddress') ?? ''}`,
        `Licence number: ${data.get('licenceNumber') ?? ''}`,
        `Products (${list.length}):`,
        ...productLines.map((x) => `- ${x}`),
        '',
        `Notes: ${data.get('message') ?? ''}`,
      ].join('\n'),
    });

    if (result.ok) {
      trackRfqSubmit('buyer', result.reference, { item_name: `${list.length} products`, country: String(data.get('country') ?? ''), source: 'direct_order' });
      setStatus(`Thank you. Your order request has been received. Reference: ${result.reference}. Our team will confirm availability, price and payment within 1-2 business days.`, 'text-[color:var(--color-success)]');
      writeCart([]);
      form.reset();
    } else {
      setStatus(`${result.error} If it keeps failing, email us at ${form.dataset.fallbackEmail}.`, 'text-[color:var(--color-error)]');
    }
    if (submitBtn) submitBtn.disabled = false;
  });
</script>
