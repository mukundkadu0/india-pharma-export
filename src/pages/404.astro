---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist or has moved." noindex={true}>
  <section class="container-page py-24 text-center">
    <span class="inline-grid place-items-center w-16 h-16 rounded-2xl bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)] mb-6">
      <Icon name="search" class="w-7 h-7" />
    </span>
    <p class="font-display text-6xl text-[color:var(--color-navy)]">404</p>
    <h1 class="mt-3 font-display text-2xl text-[color:var(--color-navy)]">We couldn't find that page</h1>
    <p class="mt-3 text-slate-600 max-w-md mx-auto">
      The page you're looking for may have moved. Try the product catalogue, or get in touch with our team directly.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href="/products/">Browse Products</Button>
      <Button href="/" variant="outline">Back to Home</Button>
    </div>
  </section>
</BaseLayout>
