---
import Icon from './Icon.astro';
import { site, legalNav } from '../data/site';
import { categoryGroups } from '../data/taxonomy';
import { buyerSegments } from '../data/buyers';

const company = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Become a partner', href: '/partner/' },
  { label: 'Markets', href: '/markets/' },
];
const compliance = [
  { label: 'Quality & Compliance', href: '/compliance/' },
  { label: 'Export guides', href: '/resources/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'FAQs', href: '/faqs/' },
  ...legalNav,
];

// Only real, configured profiles render. See the CONFIGURE note in data/site.ts.
const socials = [
  { id: 'linkedin', label: 'LinkedIn', href: site.social.linkedin },
  { id: 'twitter', label: 'X (Twitter)', href: site.social.twitter },
].filter((s) => s.href);
const colTitle = 'text-sm font-bold text-[color:var(--color-navy)] mb-3';
const link = 'hover:text-[color:var(--color-teal-dark)] hover:underline';
---

<footer class="bg-white border-t border-slate-200 text-slate-600">
  <div class="container-page py-12 grid grid-cols-2 gap-x-6 gap-y-9 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1fr]">
    <div class="col-span-2 lg:col-span-1">
      <a href="/" class="inline-block" aria-label="PharmaXports home">
        <img src="/logo-full.jpg" alt="PharmaXports - Global Pharmaceutical Sourcing" width="640" height="174" class="h-16 w-auto mix-blend-multiply" loading="lazy" />
      </a>
      <p class="mt-4 text-sm leading-relaxed max-w-xs">A B2B pharmaceutical sourcing and export platform connecting licensed international buyers with Indian manufacturing partners.</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li class="flex gap-2"><Icon name="mail" class="w-4 h-4 mt-0.5 text-[color:var(--color-teal)] shrink-0" /><a href={`mailto:${site.email}`} class={link}>{site.email}</a></li>
        <li class="flex gap-2"><Icon name="phone" class="w-4 h-4 mt-0.5 text-[color:var(--color-teal)] shrink-0" /><a href={`tel:${site.phone.replace(/\s/g, '')}`} class={link}>{site.phone}</a></li>
        <li class="flex gap-2"><Icon name="map-pin" class="w-4 h-4 mt-0.5 text-[color:var(--color-teal)] shrink-0" /><span>{site.address}</span></li>
      </ul>
      {socials.length > 0 && (
        <div class="mt-4 flex items-center gap-2.5">
          {socials.map((s) => (
            <a href={s.href} aria-label={s.label} rel="noopener" class="grid place-items-center w-10 h-10 rounded-lg bg-[color:var(--color-navy)] text-white hover:bg-[color:var(--color-navy-deep)]"><Icon name="globe" class="w-4 h-4" /></a>
          ))}
        </div>
      )}
    </div>

    <nav aria-label="Products">
      <h2 class={colTitle}>Products</h2>
      <ul class="space-y-1 text-sm">
        {categoryGroups.map((c) => <li><a href={`/products/${c.id}/`} class={link}>{c.name}</a></li>)}
        <li><a href="/products/molecules/" class={link}>Molecule index</a></li>
      </ul>
    </nav>

    <nav aria-label="Buyer solutions">
      <h2 class={colTitle}>Buyer solutions</h2>
      <ul class="space-y-1 text-sm">
        {buyerSegments.map((b) => <li><a href={`/buyers/${b.slug}/`} class={link}>{b.navLabel}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2 class={colTitle}>Company</h2>
      <ul class="space-y-1 text-sm">
        {company.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
        <li><a href="/shop/" class={link}>OTC &amp; AYUSH shop</a></li>
      </ul>
    </nav>

    <nav aria-label="Compliance and legal" class="col-span-2 lg:col-span-1">
      <h2 class={colTitle}>Compliance &amp; legal</h2>
      <ul class="space-y-1 text-sm max-lg:columns-2 max-lg:gap-x-6">
        {compliance.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="border-t border-slate-200 bg-[color:var(--color-bg)]">
    <div class="container-page py-5 text-xs text-slate-500 space-y-2">
      <p>PharmaXports is a B2B pharmaceutical sourcing and export platform. It does not sell prescription medicines to individual consumers. OTC nutraceutical and AYUSH products are available through the separate <a href="/shop/" class="underline">direct-order shop</a>. Manufacturer certifications and licences belong to the respective manufacturers and are provided on request, per product. Product information is for sourcing purposes and is not medical advice.</p>
      <p>&copy; {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>
