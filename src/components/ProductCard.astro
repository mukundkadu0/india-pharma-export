---
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import CommerceCtas from './CommerceCtas.astro';
import { exportStatusMeta, prescriptionStatusMeta, marketMeta, getCategoryGroup } from '../data/taxonomy';

interface Props {
  id: string;
  name: string;
  genericName: string;
  category?: string;
  dosageForm: string;
  strength: string;
  hsCode: string;
  exportStatus: keyof typeof exportStatusMeta;
  prescriptionStatus: keyof typeof prescriptionStatusMeta;
  marketRegions: string[];
  moq: string;
  compact?: boolean;
  pricing?: { retailPriceUsd?: number };
  images?: { src: string; alt: string }[];
}

const { id, name, genericName, category, dosageForm, strength, hsCode, exportStatus, prescriptionStatus, marketRegions, moq, compact = false, pricing, images } = Astro.props;
const es = exportStatusMeta[exportStatus];
const ps = prescriptionStatusMeta[prescriptionStatus];
const catGroup = category ? getCategoryGroup(category) : undefined;
const photo = images?.[0] ?? { src: `/images/products/${id}.webp`, alt: `${name} export pack illustration` };
---

<article class="card card-hover group flex flex-col h-full overflow-hidden">
  <a href={`/products/${id}/`} class="flex flex-col flex-1">
    <div class="relative aspect-[16/10] sm:aspect-[4/3] overflow-hidden">
      {photo ? (
        <img src={photo.src} alt={photo.alt} width="800" height="600" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
      ) : (
        <div class="tile-pattern relative w-full h-full">
          <div class="tile-dots absolute inset-0 opacity-70"></div>
          <div class="relative w-full h-full grid place-items-center">
            <span class="grid place-items-center w-16 h-16 rounded-2xl bg-white/80 backdrop-blur-sm shadow-[0_10px_24px_-8px_rgba(11,42,74,0.28)] transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-2">
              <Icon name={catGroup?.icon ?? 'capsule'} class="w-8 h-8 text-[color:var(--color-navy)]/70" />
            </span>
          </div>
        </div>
      )}
      <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
        <Badge label={es.shortLabel} className={`${es.className} !bg-white shadow-sm`} />
        <Badge label={ps.shortLabel} className={`${ps.className} !bg-white shadow-sm`} />
      </div>
    </div>

    <div class="p-5 flex-1 flex flex-col">
      <h3 class="text-base font-bold text-[color:var(--color-navy)] leading-snug group-hover:text-[color:var(--color-teal-dark)] transition-colors">{name}</h3>
      <p class="text-sm text-slate-500 mt-0.5">{genericName}</p>

      {pricing?.retailPriceUsd ? (
        <p class="mt-2 text-xl font-bold text-[color:var(--color-navy)]">${pricing.retailPriceUsd.toFixed(2)}</p>
      ) : (
        !compact && (
          <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
            <dt class="text-slate-500">Form</dt><dd class="text-slate-800 font-medium">{dosageForm}</dd>
            <dt class="text-slate-500">Strength</dt><dd class="text-slate-800 font-medium">{strength}</dd>
            <dt class="text-slate-500">HS code</dt><dd class="text-slate-800 font-medium">{hsCode}</dd>
            {Astro.props.packaging && (<><dt class="text-slate-500">Packaging</dt><dd class="text-slate-800 font-medium">{Astro.props.packaging}</dd></>)}
          </dl>
        )
      )}

      {!compact && marketRegions?.length > 0 && (
        <p class="mt-2 text-xs text-slate-500">
          Listed regions: <span class="text-slate-700">{marketRegions.map((m) => marketMeta[m]?.flagLabel ?? m).join(', ')}</span>
        </p>
      )}
    </div>
  </a>

  <div class="px-5 pb-5 pt-1 mt-auto space-y-2">
    <CommerceCtas product={Astro.props} />
    <button
      type="button"
      class="add-to-inquiry w-full inline-flex items-center justify-center gap-1.5 text-xs font-medium text-slate-500 hover:text-[color:var(--color-navy)] transition-colors py-1"
      data-id={id}
      data-name={name}
      aria-label={`Add to RFQ list: ${name}`}
    >
      <Icon name="clipboard" class="w-3.5 h-3.5" /> Add to RFQ list
    </button>
  </div>
</article>
