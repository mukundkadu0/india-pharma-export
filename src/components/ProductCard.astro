---
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import CommerceCtas from './CommerceCtas.astro';
import { exportStatusMeta, prescriptionStatusMeta, marketMeta, getCategoryGroup } from '../data/taxonomy';

interface Props {
  id: string;
  name: string;
  genericName: string;
  category?: string;
  dosageForm: string;
  strength: string;
  hsCode: string;
  exportStatus: keyof typeof exportStatusMeta;
  prescriptionStatus: keyof typeof prescriptionStatusMeta;
  marketRegions: string[];
  moq: string;
  compact?: boolean;
  pricing?: { retailPriceUsd?: number };
  images?: { src: string; alt: string }[];
}

const { id, name, genericName, category, dosageForm, strength, hsCode, exportStatus, prescriptionStatus, marketRegions, moq, compact = false, pricing, images } = Astro.props;
const es = exportStatusMeta[exportStatus];
const ps = prescriptionStatusMeta[prescriptionStatus];
const catGroup = category ? getCategoryGroup(category) : undefined;
const photo = images?.[0];
---

<article class="group flex flex-col h-full bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg hover:border-[color:var(--color-blue)]/30 transition-all">
  <a href={`/products/${id}/`} class="flex flex-col flex-1">
    <div class="relative aspect-[4/3] bg-[color:var(--color-blue-light)] overflow-hidden">
      {photo ? (
        <img src={photo.src} alt={photo.alt} loading="lazy" class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full grid place-items-center text-[color:var(--color-navy)]/20">
          <Icon name={catGroup?.icon ?? 'capsule'} class="w-14 h-14" />
        </div>
      )}
      <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
        <Badge label={es.shortLabel} className={`${es.className} !bg-white shadow-sm`} />
        <Badge label={ps.shortLabel} className={`${ps.className} !bg-white shadow-sm`} />
      </div>
    </div>

    <div class="p-5 flex-1 flex flex-col">
      <h3 class="font-display text-lg text-[color:var(--color-navy)] leading-snug group-hover:text-[color:var(--color-blue)]">{name}</h3>
      <p class="text-sm text-slate-500 mt-0.5">{genericName}</p>

      {pricing?.retailPriceUsd ? (
        <p class="mt-2 text-xl font-bold text-[color:var(--color-navy)]">${pricing.retailPriceUsd.toFixed(2)}</p>
      ) : (
        !compact && <p class="mt-2 text-xs text-slate-500">{dosageForm} · {strength} · HS {hsCode}</p>
      )}

      {!compact && marketRegions?.length > 0 && (
        <p class="mt-2 text-xs text-slate-500">
          Ships to: <span class="text-slate-700">{marketRegions.map((m) => marketMeta[m]?.flagLabel ?? m).join(', ')}</span>
        </p>
      )}
    </div>
  </a>

  <div class="px-5 pb-5 pt-1 mt-auto space-y-2">
    <CommerceCtas product={Astro.props} />
    <button
      type="button"
      class="add-to-inquiry w-full inline-flex items-center justify-center gap-1.5 text-xs font-medium text-slate-500 hover:text-[color:var(--color-navy)] py-1"
      data-id={id}
      data-name={name}
      aria-label={`Add ${name} to inquiry list`}
    >
      <Icon name="clipboard" class="w-3.5 h-3.5" /> Add to inquiry list
    </button>
  </div>
</article>
