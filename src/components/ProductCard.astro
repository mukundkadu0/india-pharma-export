---
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import { exportStatusMeta, prescriptionStatusMeta, marketMeta } from '../data/taxonomy';

interface Props {
  id: string;
  name: string;
  genericName: string;
  category?: string;
  dosageForm: string;
  strength: string;
  hsCode: string;
  exportStatus: keyof typeof exportStatusMeta;
  prescriptionStatus: keyof typeof prescriptionStatusMeta;
  marketRegions: string[];
  moq: string;
  compact?: boolean;
}

const { id, name, genericName, category, dosageForm, strength, hsCode, exportStatus, prescriptionStatus, marketRegions, moq, compact = false } = Astro.props;
const es = exportStatusMeta[exportStatus];
const ps = prescriptionStatusMeta[prescriptionStatus];
const isRx = prescriptionStatus !== 'otc';
---

<article class="group flex flex-col h-full bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg hover:border-[color:var(--color-blue)]/30 transition-all">
  <a href={`/products/${id}/`} class="p-5 flex-1 flex flex-col">
    <div class="flex flex-wrap gap-1.5 mb-3">
      <Badge label={es.shortLabel} className={es.className} />
      <Badge label={ps.shortLabel} className={ps.className} />
    </div>
    <h3 class="font-display text-lg text-[color:var(--color-navy)] leading-snug group-hover:text-[color:var(--color-blue)]">{name}</h3>
    <p class="text-sm text-slate-500 mt-0.5">{genericName}</p>

    {!compact && (
      <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-xs text-slate-600">
        <div><dt class="text-slate-400">Dosage Form</dt><dd class="font-medium text-slate-700">{dosageForm}</dd></div>
        <div><dt class="text-slate-400">Strength</dt><dd class="font-medium text-slate-700">{strength}</dd></div>
        <div><dt class="text-slate-400">HS Code</dt><dd class="font-medium text-slate-700">{hsCode}</dd></div>
        <div><dt class="text-slate-400">MOQ</dt><dd class="font-medium text-slate-700">{moq}</dd></div>
      </dl>
    )}

    {marketRegions?.length > 0 && (
      <p class="mt-3 text-xs text-slate-500">
        Target markets: <span class="text-slate-700">{marketRegions.map((m) => marketMeta[m]?.flagLabel ?? m).join(', ')}</span>
      </p>
    )}
  </a>

  <div class="px-5 pb-5 pt-1 mt-auto space-y-2">
    <button
      type="button"
      class="add-to-cart w-full inline-flex items-center justify-center gap-1.5 rounded-full bg-[color:var(--color-accent)] text-white text-sm font-semibold py-2.5 hover:bg-[#d9700f]"
      data-id={id}
      data-name={name}
      data-meta={strength}
      data-rx={isRx ? 'true' : undefined}
    >
      <Icon name="cart" class="w-4 h-4" /> Buy Now
    </button>
    <div class="flex items-center gap-2">
      <a
        href={`/request-quote/?product=${encodeURIComponent(name)}`}
        class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-full text-sm font-semibold py-2 border-2 border-[color:var(--color-navy)] text-[color:var(--color-navy)] hover:bg-[color:var(--color-blue-light)]"
      >
        Bulk Order <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
      <button
        type="button"
        class="add-to-inquiry shrink-0 grid place-items-center w-10 h-10 rounded-full border border-slate-200 text-slate-500 hover:border-[color:var(--color-navy)] hover:text-[color:var(--color-navy)]"
        data-id={id}
        data-name={name}
        aria-label={`Add ${name} to inquiry list`}
        title="Add to bulk inquiry list"
      >
        <Icon name="clipboard" class="w-4 h-4" />
      </button>
    </div>
    {isRx && (
      <p class="text-[10px] text-slate-400 text-center">Prescription product — licence verified before dispatch</p>
    )}
  </div>
</article>
