---
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  shortDescription: string;
  icon: string;
  count?: number;
}
const { id, name, shortDescription, icon, count } = Astro.props;
---

<a href={`/products/${id}/`} class="card-in card-lift group flex flex-col gap-4 p-6 bg-white ring-1 ring-slate-900/5 rounded-2xl">
  <span class="grid place-items-center w-12 h-12 rounded-xl bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)] group-hover:bg-[color:var(--color-navy)] group-hover:text-white transition-colors">
    <Icon name={icon} class="w-6 h-6" />
  </span>
  <div>
    <h3 class="font-display text-lg text-[color:var(--color-navy)]">{name}</h3>
    <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{shortDescription}</p>
    {count !== undefined && <p class="mt-2 text-xs font-medium text-slate-400">{count} classes tracked</p>}
  </div>
  <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-blue)]">
    View Products <Icon name="arrow-right" class="w-3.5 h-3.5" />
  </span>
</a>
