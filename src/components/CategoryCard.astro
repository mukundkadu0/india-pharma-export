---
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  shortDescription: string;
  icon: string;
  count?: number;
}
const { id, name, shortDescription, icon, count } = Astro.props;

const panelStyles: Record<string, string> = {
  formulations: 'from-[#FDEDE3] to-[#FBDCC9]',
  apis: 'from-[#EAF4FB] to-[#D6E9F7]',
  biologicals: 'from-[#E7F0FB] to-[#CFE0F5]',
  devices: 'from-[#EEF1F5] to-[#DCE2EA]',
  ayush: 'from-[#EAF6EC] to-[#D3EBD8]',
  nutraceuticals: 'from-[#FDF3DE] to-[#FAE6BC]',
  specialty: 'from-[#F1EAF9] to-[#E1D2F2]',
  hospital: 'from-[#E9F6F5] to-[#CFEAE8]',
};
const panel = panelStyles[id] ?? 'from-[color:var(--color-blue-light)] to-slate-100';
const photos: Record<string, string> = {
  formulations: '/images/cat-formulations.png',
  apis: '/images/cat-apis.png',
  biologicals: '/images/cat-biologicals.png',
  devices: '/images/cat-devices.png',
  ayush: '/images/cat-ayush.png',
  nutraceuticals: '/images/cat-nutraceuticals.png',
};
const photo = photos[id];
---

<a href={`/products/${id}/`} class="card-in card-lift group flex flex-col bg-white ring-1 ring-slate-900/5 rounded-xl overflow-hidden">
  <div class={`h-20 sm:h-24 grid place-items-center overflow-hidden ${photo ? '' : `bg-gradient-to-br ${panel}`}`}>
    {photo ? (
      <img src={photo} alt={name} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" width="768" height="512" />
    ) : (
      <Icon name={icon} class="w-8 h-8 sm:w-9 sm:h-9 text-[color:var(--color-navy)]" />
    )}
  </div>
  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-display text-base text-[color:var(--color-navy)]">{name}</h3>
    <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{shortDescription}</p>
    {count !== undefined && <p class="mt-2 text-xs text-slate-400">{count} {count === 1 ? 'class' : 'classes'} tracked</p>}
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-blue)]">
      View Products <Icon name="arrow-right" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
