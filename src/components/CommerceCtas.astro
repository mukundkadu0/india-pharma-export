---
import Icon from './Icon.astro';
import { countries, resolveCommerce, type CountryCode, type Cta } from '../lib/commerce';

interface Props {
  product: Record<string, any>;
  layout?: 'card' | 'detail';
}
const { product, layout = 'card' } = Astro.props;

// Resolved server-side for every country; the client only picks one.
const byCountry: Record<string, { ctas: Cta[]; reason: string | null }> = {};
for (const c of countries) {
  const r = resolveCommerce(product, c.code as CountryCode);
  byCountry[c.code] = { ctas: r.ctas, reason: r.reason };
}

const name = product.name;
const quoteHref = `/request-quote/?product=${encodeURIComponent(name)}`;
const price = product.pricing?.retailPriceUsd;
const big = layout === 'detail';
const pill = big ? 'py-3 text-sm' : 'py-2.5 text-sm';
---

<div class="commerce-ctas space-y-2" data-commerce={JSON.stringify(byCountry)} data-product-id={product.id} data-product-name={name}>
  <button
    type="button"
    data-cta="BUY_NOW"
    hidden
    class={`buy-now w-full inline-flex items-center justify-center gap-2 rounded-full bg-[color:var(--color-accent)] text-white font-semibold hover:bg-[#d9700f] ${pill}`}
    data-price={price}
  >
    <Icon name="cart" class="w-4 h-4" /> Buy Now{price ? ` — $${price.toFixed(2)}` : ''}
  </button>

  <button
    type="button"
    data-cta="ADD_TO_CART"
    hidden
    class={`add-to-cart w-full inline-flex items-center justify-center gap-2 rounded-full border-2 border-[color:var(--color-navy)] text-[color:var(--color-navy)] font-semibold hover:bg-[color:var(--color-blue-light)] ${pill}`}
    data-id={product.id}
    data-name={name}
    data-meta={product.strength}
  >
    Add to Cart
  </button>

  <button
    type="button"
    data-cta="BUY_IN_BULK"
    hidden
    class={`open-bulk-rfq w-full inline-flex items-center justify-center gap-2 rounded-full font-semibold ${pill} bg-[color:var(--color-navy)] text-white hover:bg-[color:var(--color-navy-deep)]`}
    data-product={name}
  >
    Buy in Bulk <Icon name="arrow-right" class="w-3.5 h-3.5" />
  </button>

  <a
    href={quoteHref}
    data-cta="CHECK_AVAILABILITY"
    hidden
    class={`w-full inline-flex items-center justify-center gap-2 rounded-full border-2 border-[color:var(--color-navy)] text-[color:var(--color-navy)] font-semibold hover:bg-[color:var(--color-blue-light)] ${pill}`}
  >
    Check Availability
  </a>

  <a
    href="/contact/"
    data-cta="CONTACT_US"
    hidden
    class={`w-full inline-flex items-center justify-center gap-2 rounded-full border-2 border-[color:var(--color-navy)] text-[color:var(--color-navy)] font-semibold hover:bg-[color:var(--color-blue-light)] ${pill}`}
  >
    Contact Us
  </a>

  <p class="cta-reason text-[11px] text-slate-500 text-center leading-snug" hidden></p>
</div>
