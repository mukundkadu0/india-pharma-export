---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { getCategoryGroup, exportStatusMeta, prescriptionStatusMeta } from '../data/taxonomy';
import { MOLECULE_PAGES_INDEXABLE } from '../lib/molecules';

interface Props {
  molecule: { id: string; name: string; classId: string; categoryGroup: string; buyDirect: boolean };
  classData: {
    id: string;
    name: string;
    categoryGroup: string;
    hsCode: string;
    exportStatus: 'free' | 'noc' | 'controlled';
    exportNote?: string;
    prescriptionStatus: keyof typeof prescriptionStatusMeta;
    prescriptionNote?: string;
    markets: string[];
    summary: string;
    description: string;
  };
  siblings: { id: string; name: string }[];
}

const { molecule, classData, siblings } = Astro.props;
const category = getCategoryGroup(molecule.categoryGroup);
const es = exportStatusMeta[classData.exportStatus];
// OTC only where the catalogue marks this specific molecule as direct-sale; otherwise
// fall back to the class-level prescription status.
const psKey = molecule.buyDirect ? 'otc' : classData.prescriptionStatus;
const ps = prescriptionStatusMeta[psKey];
const isRx = psKey !== 'otc';

const shortClass = classData.name.split(/[,&—]/)[0].trim();
const title = `${molecule.name} (${shortClass}) - Export from India | HS ${classData.hsCode}`;
const description = `${molecule.name} (${classData.name}), HS ${classData.hsCode}. B2B sourcing from Indian manufacturing partners for ${classData.markets.slice(0, 4).join(', ')}. Request a bulk quotation; destination registration and licensing apply.`;

// Other things on the site that genuinely relate to this molecule's class (no invented relationships).
const allProducts = (await getCollection('products')).map((p) => p.data);
const allClasses = (await getCollection('classes')).map((c) => c.data);
const classProducts = allProducts.filter((p) => p.therapeuticClass === classData.id).slice(0, 3);
const relatedClasses = allClasses.filter((c) => c.categoryGroup === classData.categoryGroup && c.id !== classData.id).slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: molecule.name,
  description: `${molecule.name} - ${classData.summary}`,
  sku: molecule.id,
  category: category?.name,
  image: new URL(`/images/molecules/${molecule.id}.webp`, Astro.site).toString(),
  brand: { '@type': 'Brand', name: 'PharmaXports' },
};

// Answer-first Q&A: short, self-contained, and built only from catalogue data
// so search engines and AI assistants can quote it directly.
const faqs = [
  {
    q: `Is ${molecule.name} freely exportable from India?`,
    a: `${molecule.name} sits in the ${classData.name} class, which is listed as "${es.label}" for export from India under a wholesale drug licence and RCMC for standard approved formulations. Export policy can change by DGFT notification, and each destination keeps its own registration rules, so confirm current status before quoting or shipping.`,
  },
  {
    q: `What is the HS code for ${molecule.name}?`,
    a: `The ${classData.name} class is classified under HS ${classData.hsCode}. Confirm the exact 8-digit ITC(HS) code for your specific formulation on the DGFT portal before shipment.`,
  },
  {
    q: `Which markets is ${molecule.name} supplied to?`,
    a: `Target markets for this class are ${classData.markets.join(', ')}. Supply is B2B to licensed importers, distributors, wholesalers, hospital groups and tender buyers; the importer holds the import licence in their own country.`,
  },
  {
    q: `How do I get a quote for ${molecule.name}?`,
    a: `Use Request Bulk Quote on this page with your required dosage form, strength, quantity and destination. PharmaXports matches the requirement to Indian manufacturing partners and confirms FOB or CIF pricing, MOQ and lead time in writing. Manufacturer certifications are confirmed per enquiry.`,
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const glance: [string, string][] = [
  ['Molecule', molecule.name],
  ['Therapeutic class', classData.name],
  ['Category', category?.name ?? 'Pharmaceuticals'],
  ['HS code (class level)', classData.hsCode],
  ['Export classification (class level)', es.label],
  ['Prescription classification', ps.label],
  ['Destination regions (class level)', classData.markets.join(', ')],
  ['Dosage form and strength', 'Confirmed per enquiry'],
  ['Minimum order quantity', 'On request'],
  ['Sourcing status', 'Listed in the molecule index. Not a statement of stock'],
];
const enquiryChecklist = ['Dosage form and strength', 'Pack size and packaging type', 'Estimated quantity and order frequency', 'Destination country and port', 'Registration status in your country, if any', 'Target price and preferred Incoterm'];
---

<BaseLayout title={title} description={description} ogType="product" noindex={!MOLECULE_PAGES_INDEXABLE}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="container-page pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Products', href: '/products/' },
        { label: classData.name, href: `/products/therapeutic-class/${classData.id}/` },
        { label: molecule.name },
      ]}
    />
  </div>

  <section class="container-page pt-6 pb-12 grid lg:grid-cols-5 gap-10" data-product-view={molecule.id} data-product-name={molecule.name}>
    <div class="lg:col-span-3 min-w-0">
      <div class="flex flex-wrap gap-2 mb-4">
        {category && <Badge label={category.name} className="bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)] border-transparent normal-case" size="md" />}
        <Badge label={es.label} className={es.className} size="md" />
        <Badge label={ps.shortLabel} className={ps.className} size="md" />
      </div>
      <p class="eyebrow">Molecule</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-[color:var(--color-navy)] leading-tight">{molecule.name}</h1>
      <p class="mt-2 text-lg text-slate-500">
        <a href={`/products/therapeutic-class/${classData.id}/`} class="hover:underline">{classData.name}</a>
      </p>

      <p class="mt-5 text-slate-700 leading-relaxed max-w-2xl">
        {molecule.name} is listed under {classData.name} in the PharmaXports molecule index. A listing means we track the molecule for B2B export
        enquiries; it does not mean stock is held. The dosage form, strength, pack and manufacturing partner are matched and confirmed in writing for each enquiry.
      </p>

      <div class="mt-8 grid sm:grid-cols-[13rem_1fr] gap-6 items-start">
        <figure>
          <img
            src={`/images/molecules/${molecule.id}.webp`}
            alt={`${molecule.name} export pack illustration`}
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
            class="w-full rounded-lg ring-1 ring-slate-900/5"
          />
          <figcaption class="mt-2 text-xs text-slate-500">Illustrative image. Actual pack, strength and artwork are confirmed per order.</figcaption>
        </figure>
        <div class="min-w-0">
          <h2 class="text-xl font-bold text-[color:var(--color-navy)] mb-3">Molecule at a glance</h2>
          <dl class="rounded-lg border border-slate-200 divide-y divide-slate-100 text-sm bg-white">
            {glance.map(([k, v]) => (
              <div class="grid grid-cols-5 gap-3 px-3 py-2.5">
                <dt class="col-span-2 text-slate-500 font-medium">{k}</dt>
                <dd class="col-span-3 text-slate-800">{v}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-2 text-xs text-slate-500">Rows marked "class level" describe the whole {classData.name} class, not a specific strength or pack.</p>
        </div>
      </div>

      <div class="mt-10">
        <h2 class="text-xl font-bold text-[color:var(--color-navy)] mb-3">What to include in your enquiry</h2>
        <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm text-slate-700">
          {enquiryChecklist.map((i) => (
            <li class="flex gap-2"><Icon name="check-circle" class="w-4 h-4 mt-0.5 text-[color:var(--color-teal-dark)] shrink-0" />{i}</li>
          ))}
        </ul>
      </div>

      <div class="mt-10">
        <h2 class="text-xl font-bold text-[color:var(--color-navy)] mb-3">Export and regulatory context</h2>
        <div class="rounded-lg border border-slate-200 bg-white p-4 space-y-3 text-sm text-slate-600 leading-relaxed">
          <p>{es.description}</p>
          {classData.exportNote && <p>{classData.exportNote}</p>}
          {classData.prescriptionNote && <p>{classData.prescriptionNote}</p>}
        </div>
        <div class="mt-4 rounded-lg bg-amber-50 border border-amber-200 p-4 text-xs text-amber-900 leading-relaxed">
          Export status can change by DGFT notification, and each destination keeps its own product registration and controlled-substance list. Verify current
          requirements before quoting or shipping. See the <a href="/compliance/" class="underline font-medium">Quality &amp; Compliance centre</a> for official sources.
        </div>
      </div>

      <div class="mt-10">
        <h2 class="text-xl font-bold text-[color:var(--color-navy)] mb-3">About the {classData.name} class</h2>
        <p class="text-slate-600 leading-relaxed">{classData.description}</p>
        <a href={`/products/therapeutic-class/${classData.id}/`} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-teal-dark)] hover:underline">
          See every molecule in this class <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <aside class="lg:col-span-2">
      <div class="sticky top-24 space-y-4">
        <div class="card p-5 sm:p-6 bg-[color:var(--color-blue-light)]">
          <h2 class="font-bold text-[color:var(--color-navy)]">Request {molecule.name}</h2>
          <p class="mt-1.5 text-sm text-slate-600">B2B quotation for licensed buyers. Pricing is quoted per requirement, destination and quantity.</p>
          <button type="button" class="open-bulk-rfq btn btn-primary w-full mt-4" data-product={molecule.name}>Request Bulk Quote</button>
          <button type="button" class="add-to-inquiry btn btn-outline w-full mt-3" data-id={molecule.id} data-name={molecule.name} data-meta={classData.name}>
            <Icon name="clipboard" class="w-4 h-4" /> Add to RFQ list
          </button>
          <a href={`/request-quote/?product=${encodeURIComponent(molecule.name)}`} class="mt-3 block text-center text-sm font-medium text-[color:var(--color-teal-dark)] hover:underline">Open the full RFQ form</a>
          {isRx && <p class="mt-4 text-xs text-slate-500 leading-relaxed">Prescription classification: supplied only to licensed importers, distributors and institutions. There is no direct consumer purchase.</p>}
        </div>
        {molecule.buyDirect && (
          <div class="card p-5 bg-[#E9F5F4] border-[color:var(--color-teal)]/30">
            <h2 class="font-bold text-[color:var(--color-navy)]">Small quantity? OTC direct order</h2>
            <p class="mt-1.5 text-sm text-slate-700">This OTC item can be requested without a B2B minimum. It is a separate order request: no prices or card payment on this site, and our team confirms availability, price and payment first.</p>
            <button type="button" class="add-to-cart btn btn-navy w-full mt-3" data-id={molecule.id} data-name={molecule.name} data-meta={classData.name}>
              <Icon name="cart" class="w-4 h-4" /> Add to order request
            </button>
            <a href="/shop/cart/" class="mt-2 block text-center text-sm font-medium text-[color:var(--color-teal-dark)] hover:underline">View my order request</a>
          </div>
        )}
      </div>
    </aside>
  </section>

  <section class="container-page pb-12">
    <h2 class="text-2xl font-bold text-[color:var(--color-navy)] mb-5">Quick answers</h2>
    <div class="grid md:grid-cols-2 gap-4 max-w-4xl">
      {faqs.map((f) => (
        <div class="card p-4">
          <h3 class="font-semibold text-[color:var(--color-ink)]">{f.q}</h3>
          <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  {classProducts.length > 0 && (
    <section class="bg-[color:var(--color-bg)] border-t border-slate-200">
      <div class="container-page py-12">
        <h2 class="text-2xl font-bold text-[color:var(--color-navy)] mb-2">Catalogued products in this class</h2>
        <p class="text-sm text-slate-600 mb-6 max-w-2xl">These are product listings with full specifications, in the same therapeutic class.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {classProducts.map((p) => <ProductCard {...p} />)}
        </div>
      </div>
    </section>
  )}

  <section class={`${classProducts.length > 0 ? '' : 'bg-[color:var(--color-bg)] border-t border-slate-200'}`}>
    <div class="container-page py-12 space-y-10">
      {siblings.length > 0 && (
        <div>
          <h2 class="text-xl font-bold text-[color:var(--color-navy)] mb-4">More molecules in {classData.name}</h2>
          <ul class="flex flex-wrap gap-2">
            {siblings.map((s) => (
              <li><a href={`/products/${s.id}/`} class="chip">{s.name}</a></li>
            ))}
          </ul>
        </div>
      )}
      {relatedClasses.length > 0 && (
        <div>
          <h2 class="text-xl font-bold text-[color:var(--color-navy)] mb-4">Related therapeutic classes{category ? ` in ${category.name}` : ''}</h2>
          <ul class="flex flex-wrap gap-2">
            {relatedClasses.map((c) => (
              <li><a href={`/products/therapeutic-class/${c.id}/`} class="chip">{c.name}</a></li>
            ))}
          </ul>
        </div>
      )}
      <p class="text-sm text-slate-600">
        Looking for another molecule? Search the <a href="/products/molecules/" class="font-semibold text-[color:var(--color-teal-dark)] underline">molecule index</a>,
        browse the <a href="/products/" class="font-semibold text-[color:var(--color-teal-dark)] underline">product catalogue</a>, or check
        <a href="/markets/" class="font-semibold text-[color:var(--color-teal-dark)] underline">destination markets</a>.
      </p>
    </div>
  </section>
</BaseLayout>
