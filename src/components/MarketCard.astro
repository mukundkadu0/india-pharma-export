---
import SkylineIllustration from './SkylineIllustration.astro';

interface Props {
  id: string;
  name: string;
  character: string;
  skylineVariant?: 'us' | 'eu' | 'africa' | 'latam' | 'cis' | 'middle-east' | 'sea';
}
const { id, name, character, skylineVariant = 'us' } = Astro.props;

const photos: Record<string, string> = {
  us: '/images/market-us.png',
  eu: '/images/market-eu.png',
  africa: '/images/market-africa.png',
  latam: '/images/market-latam.png',
  cis: '/images/market-cis.png',
  'middle-east': '/images/market-middle-east.png',
  sea: '/images/market-sea.png',
};
const photo = photos[skylineVariant];
---

<a href={`/markets/${id}/`} class="card-in card-lift group flex flex-col bg-white ring-1 ring-slate-900/5 rounded-2xl overflow-hidden">
  <div class="h-28 sm:h-32 overflow-hidden">
    {photo ? (
      <img src={photo} alt={`${name} skyline`} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" width="768" height="512" />
    ) : (
      <SkylineIllustration variant={skylineVariant} />
    )}
  </div>
  <div class="p-4">
    <h3 class="font-display text-base text-[color:var(--color-navy)] group-hover:text-[color:var(--color-blue)]">{name}</h3>
    <p class="mt-1 text-xs text-slate-500 leading-snug">{character}</p>
  </div>
</a>
