---
import Icon from './Icon.astro';
import Badge from './Badge.astro';

interface Props {
  id: string;
  name: string;
  tierLabel: string;
  character: string;
  countries: string[];
}
const { id, name, tierLabel, character, countries } = Astro.props;
---

<a href={`/markets/${id}/`} class="group flex flex-col gap-3 p-6 bg-white border border-slate-200 rounded-2xl hover:border-[color:var(--color-blue)]/40 hover:shadow-lg transition-all">
  <span class="grid place-items-center w-11 h-11 rounded-xl bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)] group-hover:bg-[color:var(--color-navy)] group-hover:text-white transition-colors">
    <Icon name="globe" class="w-5 h-5" />
  </span>
  <h3 class="font-display text-lg text-[color:var(--color-navy)]">{name}</h3>
  <p class="text-sm text-slate-600">{character}</p>
  <Badge label={tierLabel} className="bg-slate-500/10 text-slate-600 border-slate-400/30 normal-case" />
  <p class="text-xs text-slate-400">{countries.slice(0, 4).join(', ')}{countries.length > 4 ? ` +${countries.length - 4} more` : ''}</p>
  <span class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-blue)]">
    Explore Market <Icon name="arrow-right" class="w-3.5 h-3.5" />
  </span>
</a>
