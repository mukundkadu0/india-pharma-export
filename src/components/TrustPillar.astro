---
import Icon from './Icon.astro';
interface Props {
  icon: string;
  title: string;
  description: string;
}
const { icon, title, description } = Astro.props;
---

<div class="flex gap-4">
  <span class="shrink-0 grid place-items-center w-11 h-11 rounded-xl bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)]">
    <Icon name={icon} class="w-5 h-5" />
  </span>
  <div>
    <h3 class="font-semibold text-[color:var(--color-ink)]">{title}</h3>
    <p class="mt-1 text-sm text-slate-600 leading-relaxed">{description}</p>
  </div>
</div>
