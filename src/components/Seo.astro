---
import { site } from '../data/site';
import { hreflangEntries, locales, localeFromPath } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: string;
  image?: string;
}
const { title, description, noindex = false, ogType = 'website', image } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('PharmaXports') ? title : `${title} | PharmaXports`;
const ogImage = image ?? '/og-default.png';
const alternates = hreflangEntries(Astro.url.pathname, Astro.site!);
const ogLocale = locales[localeFromPath(Astro.url.pathname)].ogLocale;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={new URL(ogImage, Astro.site)} />
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content={ogLocale} />
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
