---
import { site } from '../data/site';
import { buyerTypes } from '../data/taxonomy';
import { countries } from '../lib/commerce';

// One component for every enquiry entry point: the Request a Quote page, home, product, molecule, the
// bulk-quote modal (variant="modal"), partnership and general contact. The buyer RFQ is one short form;
// partnership and general enquiries are single-step. Several forms can share a page: give each its own `idp`.
interface Props {
  prefillProduct?: string;
  kind?: 'buyer' | 'partnership' | 'general';
  idp?: string;
  variant?: 'page' | 'modal';
}
const { prefillProduct = '', kind = 'buyer', idp = 'qf', variant = 'page' } = Astro.props;
const countryNames = Object.fromEntries(countries.map((c) => [c.code, c.name]));
const modal = variant === 'modal';

const copy = {
  buyer: {
    intro: 'Tell us what you need and where it is going. We reply by email within 1-2 business days.',
    submit: 'Submit RFQ',
    subject: 'New Export Quote Request - PharmaXports',
    done: 'Our team will reply by email within 1-2 business days.',
  },
  partnership: {
    intro: 'For manufacturers, suppliers, distributors and sourcing agents who want to work with PharmaXports.',
    submit: 'Send Partnership Enquiry',
    subject: 'New Partnership Enquiry - PharmaXports',
    done: 'Our partnerships team will review it and reply by email.',
  },
  general: {
    intro: 'Tell us what you need and we will route your message to the right person.',
    submit: 'Send Message',
    subject: 'New General Enquiry - PharmaXports',
    done: 'Our team will reply by email.',
  },
}[kind];
const partnershipTypes = ['Manufacturer / supplier', 'Distributor / importer', 'Sourcing agent / representative', 'Logistics / compliance partner', 'Other'];
const currencies = ['No preference', 'USD', 'EUR', 'GBP', 'AED', 'INR', 'Other'];
const incoterms = ['Not sure, please advise', 'EXW', 'FCA', 'FOB', 'CFR', 'CIF', 'CIP', 'DAP', 'DDP'];
const phoneAttrs = { pattern: '[0-9+ \\(\\)\\-]{7,20}', title: '7-20 characters: digits, +, spaces, brackets, dashes' };
const fileClass = 'block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-[color:var(--color-navy)] file:text-white file:px-4 file:py-2.5 file:font-semibold';
const steps = ['Requirement', 'Your details', 'Specifications'];
const id = (s: string) => `${idp}-${s}`;
---

<form
  id={id('form')}
  data-rfq-form
  data-idp={idp}
  data-variant={variant}
  data-countries={JSON.stringify(countryNames)}
  data-endpoint={site.formEndpoint}
  data-fallback-email={site.email}
  data-kind={kind}
  class={modal ? 'p-5 sm:p-6' : 'card p-5 sm:p-8'}
  novalidate
>
  <div id={id('fields')}>
    {!modal && <p class="text-sm text-slate-600 mb-4">{copy.intro}</p>}

    <p class="text-xs text-slate-500 mb-4">Fields marked * are required.</p>

    {kind === 'buyer' && (
      <fieldset data-step="1" class="border-0 p-0 m-0 min-w-0">
        <legend class="sr-only" tabindex="-1">Request a quote</legend>
        <div class="space-y-5">
          <div>
            <label for={id('product')} class="label">Medicine(s) you need *</label>
            <textarea id={id('product')} name="product" rows="2" required class="field" placeholder="e.g. Paracetamol tablets IP 500 mg. For several products, list one per line.">{prefillProduct}</textarea>
            <div id={id('rfq-list')} hidden class="mt-2 text-sm">
              <button type="button" id={id('use-list')} class="font-semibold text-[color:var(--color-teal-dark)] underline">Use my RFQ list (<span id={id('list-count')}>0</span> products)</button>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for={id('quantity')} class="label">Quantity *</label>
              <input id={id('quantity')} name="quantity" type="text" required placeholder="e.g. 100,000 tablets per month" class="field" />
            </div>
            <div>
              <label for={id('country')} class="label">Country *</label>
              <input id={id('country')} name="country" type="text" required autocomplete="country-name" class="field" />
            </div>
            <div>
              <label for={id('company')} class="label">Company name *</label>
              <input id={id('company')} name="companyName" type="text" required autocomplete="organization" class="field" />
            </div>
            <div>
              <label for={id('buyer-type')} class="label">Buyer type *</label>
              <select id={id('buyer-type')} name="buyerType" required class="field">
                <option value="">Select buyer typeâ€¦</option>
                {buyerTypes.map((b) => <option value={b.name}>{b.name}</option>)}
                <option value="Other">Other</option>
              </select>
            </div>
            <div>
              <label for={id('email')} class="label">Email *</label>
              <input id={id('email')} name="email" type="email" required autocomplete="email" inputmode="email" class="field" />
            </div>
            <div>
              <label for={id('phone')} class="label">Mobile number *</label>
              <input id={id('phone')} name="phone" type="tel" required autocomplete="tel" inputmode="tel" pattern={phoneAttrs.pattern} title={phoneAttrs.title} placeholder="+91 98765 43210" class="field" />
            </div>
          </div>
        </div>
      </fieldset>
    )}

    {kind !== 'buyer' && (
      <>
        <div class="grid sm:grid-cols-2 gap-5">
          <div><label for={id('name')} class="label">Full name *</label><input id={id('name')} name="fullName" type="text" required autocomplete="name" class="field" /></div>
          <div><label for={id('company')} class="label">Company name {kind !== 'general' ? '*' : ''}</label><input id={id('company')} name="companyName" type="text" required={kind !== 'general'} autocomplete="organization" class="field" /></div>
          <div><label for={id('email')} class="label">Email *</label><input id={id('email')} name="email" type="email" required autocomplete="email" inputmode="email" class="field" /></div>
          <div><label for={id('country')} class="label">Country {kind !== 'general' ? '*' : ''}</label><input id={id('country')} name="country" type="text" required={kind !== 'general'} autocomplete="country-name" class="field" /></div>
          {kind === 'partnership' && (
            <div>
              <label for={id('ptype')} class="label">Partnership type *</label>
              <select id={id('ptype')} name="partnershipType" required class="field">
                <option value="">Select typeâ€¦</option>
                {partnershipTypes.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
          )}
          <div>
            <label for={id('phone')} class="label">Phone / WhatsApp (optional)</label>
            <input id={id('phone')} name="phone" type="tel" autocomplete="tel" inputmode="tel" pattern={phoneAttrs.pattern} title={phoneAttrs.title} class="field" />
          </div>
        </div>
        <div class="mt-5">
          <label for={id('message')} class="label">{kind === 'partnership' ? 'About your company and what you offer *' : 'Your message *'}</label>
          <textarea id={id('message')} name="message" rows="5" required class="field"></textarea>
        </div>
        {kind === 'partnership' && (
          <div class="mt-5">
            <label for={id('file')} class="label">Company profile or product list (optional: PDF, XLSX, XLS or CSV, up to 4 MB)</label>
            <input id={id('file')} name="attachment" type="file" accept=".pdf,.xlsx,.xls,.csv" aria-describedby={id('file-help')} class={fileClass} />
            <p id={id('file-help')} class="mt-1 text-xs text-slate-500">Checked on our server before it is accepted.</p>
          </div>
        )}
      </>
    )}

    <!-- Honeypot anti-spam field: hidden from real users, left blank -->
    <div class="hidden" aria-hidden="true">
      <label for={id('hp')}>Leave this field blank</label>
      <input id={id('hp')} name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="rfq_mode" value={kind === 'buyer' ? 'full' : 'basic'} />
    <input type="hidden" name="access_key" value={site.formAccessKey} />
    <input type="hidden" name="subject" value={copy.subject} />
    <input type="hidden" name="entry_point" value={modal ? 'bulk_modal' : 'page_form'} />

    <p id={id('status')} class="mt-4 text-sm hidden" role="alert" aria-live="assertive"></p>

    <div class="mt-6 flex items-center justify-between flex-wrap gap-3">
      <p class="text-xs text-slate-500 max-w-sm order-2 sm:order-1">We use these details only to respond to your enquiry. We do not sell or share them. See our <a href="/privacy/" class="underline">Privacy Policy</a>.</p>
      <div class="flex gap-3 order-1 sm:order-2 w-full sm:w-auto">
        {kind === 'buyer' && <button type="button" id={id('back')} hidden class="btn btn-outline">Back</button>}
        {kind === 'buyer' && <button type="button" id={id('next')} class="btn btn-navy flex-1 sm:flex-none">Next</button>}
        <button type="submit" id={id('submit')} class="btn btn-primary btn-lg flex-1 sm:flex-none" hidden={kind === 'buyer'}>{copy.submit}</button>
      </div>
    </div>
  </div>

  <div id={id('success')} hidden tabindex="-1" role="status" class="text-center py-8 outline-none">
    <p class="text-2xl font-bold text-[color:var(--color-navy)]">Enquiry received</p>
    <p class="mt-2 text-slate-600">Your reference is <strong id={id('ref')} class="text-[color:var(--color-navy)]"></strong>. {copy.done} Quote the reference if you contact us about this request.</p>
    {kind === 'buyer' && <p class="mt-3 text-sm text-slate-500">Pricing, availability and export eligibility are confirmed in writing before any commitment.</p>}
    {modal && <button type="button" data-close-bulk class="btn btn-outline mt-6">Close</button>}
  </div>
</form>

<style>
  [data-progress].is-active .qf-dot { background: var(--color-navy); border-color: var(--color-navy); color: #fff; }
  [data-progress].is-active .qf-dot-label { color: var(--color-navy); display: inline; }
  [data-progress].is-done .qf-dot { background: var(--color-teal-dark); border-color: var(--color-teal-dark); color: #fff; }
</style>

<script>
  import { submitEnquiry, trackRfqStart, trackRfqSubmit, type EnquiryKind } from '../lib/rfq-client';

  // Every form on the page is initialised the same way, so the page form and the bulk modal cannot drift apart.
  document.querySelectorAll<HTMLFormElement>('form[data-rfq-form]').forEach(initRfqForm);

  function initRfqForm(form: HTMLFormElement) {
    const kind = (form.dataset.kind as EnquiryKind) || 'general';
    const idp = form.dataset.idp || 'qf';
    const isModal = form.dataset.variant === 'modal';
    const el = <T extends HTMLElement>(s: string) => document.getElementById(`${idp}-${s}`) as T | null;
    const val = (n: string) => String((form.elements.namedItem(n) as HTMLInputElement | null)?.value || '');
    const status = el('status');
    trackRfqStart(form, kind);

    let countryNames: Record<string, string> = {};
    try { countryNames = JSON.parse(form.dataset.countries || '{}'); } catch { /* optional convenience only */ }

    const setIf = (s: string, v: string | null) => { const f = el<HTMLInputElement>(s); if (f && v && !f.value) f.value = v.slice(0, 500); };
    const hasChosenCountry = () => { try { const c = localStorage.getItem('px-country'); return c && c !== 'OTHER' ? countryNames[c] || '' : ''; } catch { return ''; } };

    // ---- prefill: the page form reads the URL (?product=&country=&quantity=&buyer=); the modal is prefilled on open
    if (!isModal) {
      const params = new URLSearchParams(window.location.search);
      setIf('product', params.get('product'));
      setIf('country', params.get('country'));
      setIf('quantity', params.get('quantity'));
      const buyerSel = el<HTMLSelectElement>('buyer-type');
      const wantBuyer = params.get('buyer');
      if (buyerSel && wantBuyer) { const o = Array.from(buyerSel.options).find((x) => x.value === wantBuyer); if (o) buyerSel.value = o.value; }
    }

    // ---- the RFQ list (multi-product): offered in step 1 whenever it has items
    function refreshRfqList() {
      if (kind !== 'buyer') return;
      try {
        const list = JSON.parse(localStorage.getItem('ipe-inquiry-list') || '[]') as { name: string }[];
        const box = el('rfq-list');
        if (Array.isArray(list) && list.length) {
          box?.removeAttribute('hidden');
          const c = el('list-count'); if (c) c.textContent = String(list.length);
          const btn = el<HTMLButtonElement>('use-list');
          if (btn) btn.onclick = () => { const p = el<HTMLTextAreaElement>('product'); if (p) p.value = list.map((i) => i.name).join('\n'); };
        } else box?.setAttribute('hidden', '');
      } catch { /* RFQ list unavailable: the visitor can type products instead */ }
    }
    refreshRfqList();

    // ---- stepper (buyer RFQ only)
    const fieldsets = Array.from(form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]'));
    let step = 1;
    const backBtn = el<HTMLButtonElement>('back');
    const nextBtn = el<HTMLButtonElement>('next');
    const submitBtn = el<HTMLButtonElement>('submit');

    function showStep(n: number, focus = true) {
      step = n;
      fieldsets.forEach((fs) => { fs.hidden = Number(fs.dataset.step) !== n; });
      form.querySelectorAll<HTMLElement>('[data-progress]').forEach((li) => {
        const i = Number(li.dataset.progress);
        li.classList.toggle('is-active', i === n);
        li.classList.toggle('is-done', i < n);
        if (i === n) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
      });
      const last = n === fieldsets.length;
      if (backBtn) backBtn.hidden = n === 1;
      if (nextBtn) nextBtn.hidden = last;
      if (submitBtn) submitBtn.hidden = !last;
      if (focus) fieldsets[n - 1]?.querySelector<HTMLElement>('legend')?.focus();
    }
    function stepValid(n: number) {
      const fs = fieldsets[n - 1];
      const fields = Array.from(fs.querySelectorAll<HTMLInputElement>('input, select, textarea'));
      for (const f of fields) { if (!f.checkValidity()) { f.reportValidity(); return false; } }
      return true;
    }
    if (fieldsets.length) {
      showStep(1, false);
      nextBtn?.addEventListener('click', () => { if (stepValid(step)) showStep(step + 1); });
      backBtn?.addEventListener('click', () => showStep(step - 1));
    }

    // ---- the modal calls this each time it opens: fresh form, step 1, product (and a chosen country) prefilled
    form.addEventListener('rfq:open', (e) => {
      const detail = (e as CustomEvent<{ product?: string }>).detail || {};
      form.reset();
      delete form.dataset.idemKey;
      el('fields')?.removeAttribute('hidden');
      el('success')?.setAttribute('hidden', '');
      if (status) { status.textContent = ''; status.classList.add('hidden'); }
      if (submitBtn) submitBtn.disabled = false;
      sending = false;
      setIf('product', detail.product || '');
      setIf('country', hasChosenCountry());
      refreshRfqList();
      if (fieldsets.length) showStep(1, false);
      const first = el<HTMLElement>(detail.product ? 'quantity' : 'product');
      first?.focus();
    });

    let sending = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return; // blocks double clicks
      if (fieldsets.length && step < fieldsets.length) { if (stepValid(step)) showStep(step + 1); return; } // Enter key advances the step
      if (fieldsets.length) {
        for (let n = 1; n <= fieldsets.length; n++) {
          showStep(n, false); // a hidden field cannot show its validation bubble, so reveal the step first
          if (!stepValid(n)) return;
        }
        showStep(fieldsets.length, false);
      } else if (!form.checkValidity()) { form.reportValidity(); return; }
      if (val('companyWebsite')) return;

      sending = true;
      if (submitBtn) submitBtn.disabled = true;
      if (status) { status.textContent = 'Sendingâ€¦'; status.className = 'mt-4 text-sm text-slate-600'; }

      const result = await submitEnquiry(form, kind, form.dataset.endpoint || '');
      sending = false;

      if (result.ok) {
        trackRfqSubmit(kind, result.reference, { item_name: val('product'), country: val('country'), source: isModal ? 'bulk_modal' : 'page_form' });
        const refEl = el('ref');
        if (refEl) refEl.textContent = result.reference;
        el('fields')?.setAttribute('hidden', '');
        const ok = el('success');
        ok?.removeAttribute('hidden');
        ok?.focus();
        form.reset();
      } else {
        if (status) {
          status.textContent = `${result.error} If the problem continues, email us at ${form.dataset.fallbackEmail}.`;
          status.className = 'mt-4 text-sm text-[color:var(--color-error)]';
        }
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
