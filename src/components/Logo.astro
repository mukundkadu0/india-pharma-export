---
interface Props {
  class?: string;
  gap?: string; // kept for call-site compatibility; the tile needs no knock-out colour
}
const { class: className = 'w-10 h-10' } = Astro.props;
// SVG ids must be unique per page (header and footer both render this), so derive them from the size class.
const u = 'px' + className.replace(/[^a-z0-9]/gi, '');
---

<!--
  PharmaXports mark: a capsule (the medicine) circled by an orbit ring that ends in an
  arrow (the export). Navy-to-blue tile, white and orange capsule halves.
-->
<svg viewBox="0 0 48 48" class={className} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="PharmaXports">
  <defs>
    <linearGradient id={`${u}-tile`} x1="6" y1="4" x2="42" y2="46" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#1b78c2" />
      <stop offset="1" stop-color="#0b2a4a" />
    </linearGradient>
    <linearGradient id={`${u}-orange`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffa045" />
      <stop offset="1" stop-color="#f06a12" />
    </linearGradient>
    <clipPath id={`${u}-capsule`}>
      <rect x="12" y="19" width="24" height="10" rx="5" transform="rotate(-38 24 24)" />
    </clipPath>
  </defs>

  <rect x="1" y="1" width="46" height="46" rx="13" fill={`url(#${u}-tile)`} />
  <path d="M1 18C9 10 22 6 34 8 41 9.5 45 14 47 20V34a13 13 0 0 1-13 13H14A13 13 0 0 1 1 34Z" fill="#fff" opacity="0.06" />

  <!-- orbit ring with export arrowhead -->
  <path d="M8.5 31.5C6.5 22 14 12.5 25 11.2c6.5-.8 12 1.2 15 4.6" fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="1.6" stroke-linecap="round" />
  <path d="M42.6 19 41.9 13.7 37.8 17.4Z" fill="#fff" fill-opacity="0.9" stroke="#fff" stroke-opacity="0.9" stroke-width="0.8" stroke-linejoin="round" />

  <!-- capsule -->
  <g clip-path={`url(#${u}-capsule)`}>
    <rect x="0" y="0" width="48" height="48" fill="#fff" />
    <rect x="24" y="0" width="30" height="48" fill={`url(#${u}-orange)`} transform="rotate(-38 24 24)" />
  </g>
  <rect x="12" y="19" width="24" height="10" rx="5" transform="rotate(-38 24 24)" fill="none" stroke="#0b2a4a" stroke-opacity="0.25" stroke-width="0.8" /></svg>
