---
interface Props {
  label: string;
  className?: string;
  size?: 'sm' | 'md';
}
const { label, className = 'bg-slate-500/10 text-slate-600 border-slate-400/30', size = 'sm' } = Astro.props;
const sizeClass = size === 'sm' ? 'text-xs px-2.5 py-1' : 'text-sm px-3 py-1.5';
---

<span class={`inline-flex items-center gap-1 rounded-full border font-semibold uppercase tracking-wide ${sizeClass} ${className}`}>
  {label}
</span>
