---
import Icon from './Icon.astro';

const routes = [
  { label: 'US', top: '18%', left: '10%' },
  { label: 'EU', top: '14%', left: '54%' },
  { label: 'CIS · Asia', top: '20%', left: '86%' },
  { label: 'Africa', top: '58%', left: '62%' },
  { label: 'LatAm', top: '62%', left: '16%' },
];
---

<div class="relative w-full aspect-[6/5] sm:aspect-[4/3] lg:aspect-[5/4] rounded-3xl overflow-hidden bg-gradient-to-br from-[color:var(--color-blue-light)] via-[#eef4fa] to-white border border-slate-200/70">
  <!-- dotted world-map texture -->
  <svg class="absolute inset-0 w-full h-full opacity-70" aria-hidden="true">
    <defs>
      <pattern id="hero-dot-grid" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="1.2" cy="1.2" r="1.1" fill="#0B2A4A" opacity="0.16" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-dot-grid)" />
  </svg>

  <!-- route lines from India hub -->
  <svg class="absolute inset-0 w-full h-full" aria-hidden="true">
    {routes.map((r) => (
      <line x1="46%" y1="42%" x2={r.left} y2={r.top} stroke="#1261A0" stroke-width="1.5" stroke-dasharray="1 5" stroke-linecap="round" opacity="0.55" />
    ))}
  </svg>

  <!-- India hub -->
  <div class="absolute flex flex-col items-center gap-1 -translate-x-1/2 -translate-y-1/2" style="top:42%; left:46%;">
    <span class="grid place-items-center w-3.5 h-3.5 rounded-full bg-[color:var(--color-accent)] ring-4 ring-[color:var(--color-accent)]/25"></span>
  </div>

  {routes.map((r) => (
    <div class="absolute flex items-center gap-1.5 -translate-x-1/2 -translate-y-1/2" style={`top:${r.top}; left:${r.left};`}>
      <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-navy)]"></span>
      <span class="text-[10px] sm:text-xs font-semibold text-[color:var(--color-navy)] bg-white/80 backdrop-blur px-1.5 py-0.5 rounded whitespace-nowrap">{r.label}</span>
    </div>
  ))}

  <!-- caption -->
  <div class="absolute left-[6%] top-[6%] max-w-[40%]">
    <p class="font-serif italic text-[color:var(--color-navy)] text-sm sm:text-base leading-snug">Made in India<br />for a Healthier World</p>
    <span class="block w-8 h-0.5 bg-[color:var(--color-accent)] mt-2"></span>
  </div>

  <!-- trust card -->
  <div class="absolute right-[5%] top-[8%] bg-white rounded-xl shadow-lg px-4 py-3 max-w-[42%]">
    <p class="text-[11px] sm:text-xs font-semibold text-[color:var(--color-navy)] leading-tight">Better Medicines</p>
    <p class="text-[11px] sm:text-xs font-semibold text-[color:var(--color-accent)] leading-tight">Brighter Lives</p>
  </div>

  <!-- cargo ship (real photo) -->
  <div class="absolute left-[2%] bottom-[6%] w-[62%] sm:w-[58%] h-[38%] sm:h-[42%] rounded-xl overflow-hidden shadow-lg ring-1 ring-black/5">
    <img src="/images/hero-ship.png" alt="" loading="lazy" class="w-full h-full object-cover" style="object-position: 50% 30%;" />
  </div>

  <!-- pharma cluster (real photos) -->
  <div class="absolute right-[6%] bottom-[8%] flex items-end gap-2 sm:gap-3">
    <div class="w-12 h-16 sm:w-14 sm:h-20 rounded-xl overflow-hidden shadow-lg ring-1 ring-black/5">
      <img src="/images/cat-biologicals.png" alt="" loading="lazy" class="w-full h-full object-cover" />
    </div>
    <div class="w-16 h-14 sm:w-20 sm:h-16 rounded-xl overflow-hidden shadow-lg ring-1 ring-black/5">
      <img src="/images/cat-formulations.png" alt="" loading="lazy" class="w-full h-full object-cover" />
    </div>
  </div>
</div>
