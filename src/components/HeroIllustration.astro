---
---

<div class="hero-illustration relative w-full aspect-[4/3] sm:aspect-[16/10] lg:aspect-[2/1] rounded-3xl overflow-hidden bg-gradient-to-br from-[color:var(--color-blue-light)] via-[#eef4fa] to-white border border-slate-200/70">
  <img
    src="/images/hero-composite.png"
    alt="Container ship, cargo plane and pharmaceutical products moving from India to global markets on a world map"
    class="hero-photo w-full h-full object-contain"
    width="1800"
    height="874"
  />

  <!-- trust card, placed over the open water in the bottom-left — the one
       calm area of the photo with nothing else in it -->
  <div class="hero-fade-up absolute left-[3%] bottom-[6%] bg-white rounded-xl shadow-lg px-4 py-3 max-w-[34%]">
    <p class="text-[11px] sm:text-xs font-semibold text-[color:var(--color-navy)] leading-tight">Better Medicines</p>
    <p class="text-[11px] sm:text-xs font-semibold text-[color:var(--color-accent)] leading-tight">Brighter Lives</p>
  </div>
</div>

<style>
  /* Photo: a slow, barely-there zoom-in on mount -- purpose is delight on a
     once-per-session marketing hero, not a frequent UI element. Scale only
     (never opacity 0 -> the image should be visible immediately), so there
     is no flash of blank space while it "arrives". */
  .hero-photo {
    animation: hero-photo-in 1400ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  @keyframes hero-photo-in {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1);
    }
  }

  .hero-fade-up {
    opacity: 0;
    transform: translateY(8px);
    animation: hero-fade-up 500ms cubic-bezier(0.23, 1, 0.32, 1) 400ms both;
  }

  @keyframes hero-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      animation: none;
    }
    .hero-fade-up {
      animation-duration: 400ms;
      animation-delay: 0ms;
    }
  }
</style>
