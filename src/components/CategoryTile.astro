---
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  shortDescription: string;
  icon: string;
}
const { id, name, shortDescription, icon } = Astro.props;

const panelStyles: Record<string, string> = {
  formulations: 'from-[#FDEDE3] to-[#FBDCC9]',
  apis: 'from-[#EAF4FB] to-[#D6E9F7]',
  biologicals: 'from-[#E7F0FB] to-[#CFE0F5]',
  devices: 'from-[#EEF1F5] to-[#DCE2EA]',
  ayush: 'from-[#EAF6EC] to-[#D3EBD8]',
  nutraceuticals: 'from-[#FDF3DE] to-[#FAE6BC]',
  specialty: 'from-[#F1EAF9] to-[#E1D2F2]',
  hospital: 'from-[#E9F6F5] to-[#CFEAE8]',
};
const panel = panelStyles[id] ?? 'from-[color:var(--color-blue-light)] to-slate-100';
---

<a href={`/products/${id}/`} class="group flex flex-col bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-[color:var(--color-blue)]/40 hover:shadow-lg transition-all">
  <div class={`h-28 sm:h-32 grid place-items-center bg-gradient-to-br ${panel}`}>
    <Icon name={icon} class="w-10 h-10 sm:w-12 sm:h-12 text-[color:var(--color-navy)]" />
  </div>
  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-display text-base text-[color:var(--color-navy)] group-hover:text-[color:var(--color-blue)]">{name}</h3>
    <p class="mt-1.5 text-sm text-slate-600 leading-relaxed flex-1">{shortDescription}</p>
    <span class="mt-3 grid place-items-center w-8 h-8 rounded-full bg-[color:var(--color-blue-light)] text-[color:var(--color-navy)] group-hover:bg-[color:var(--color-navy)] group-hover:text-white transition-colors">
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </span>
  </div>
</a>
